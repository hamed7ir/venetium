# out\arm-pgo — the ARM32 PGO + ThinLTO release build (Venetium PGO step 3, his decision 2026-10-24: "both pgo and thinlto").
# = out\arm-rt21\args.gn (the device-proven v1.2 ARM32 build) with ONLY the three lines in the PGO/LTO block changed, so the
# compile pipeline in front of the PGO pass matches the instrumented build (out\arm-instr) the profile was gathered with.
# Profile: chrome\build\pgo_profiles\venetium-arm32-20261026.profdata (sha256 f67c2bf5880cdab5...), merged with rt2.1
# llvm-profdata from 6 device .profraw (Tegra, 2026-10-26: Speedometer + browsing + video; 1,266,964 functions, 1.9e9 counts).
# The server recreates the directory from this file alone: `gn gen out\arm-pgo` after `source venetium/env/build-env.sh`.

# --- the build (his decisions 2026-09-28/29; ARM-1) ---
target_cpu = "arm"
is_debug = false
dcheck_always_on = false
is_component_build = false
symbol_level = 1                 # line tables in the PDBs for crash stacks; the PDBs are not shipped
generate_about_credits = true    # chrome://credits carries Supermium's credit
# is_official_build = true comes from venetium.gn (v1.2).

# --- toolchain: rt2.1 and rustc-rt2.1 (the sysroot has the thumbv7a-pc-windows-msvc std since RUSTC-2, 21 rlibs) ---
# rt21-lto = rt2.1 (rt21-cr, hard links: clang-cl d572c493…, llvm-lib/llvm-ar 9e197c48…) + lld 33b9fa09 with three Windows
# ARM32 ThinLTO fixes (static reloc model for ARMNT: /GS "Cannot represent this expression"; absolute delay-load helper
# call: "relocation out of range"; CGProfile skips intrinsic callees: "undefined symbol llvm.exp2.f64"). See F:\cr\rt21-lto\RT21-LTO.txt. arm-rt21 / x86-rt21 keep rt21-cr.
clang_base_path = "F:/cr/rt21-lto"
clang_version = "23"
rust_sysroot_absolute = "F:/cr/rustc-rt21"
rustc_version = "rustc-1.100.0-nightly-bba531001-2026-09-20-rt2.1-31b4bac5e615"
added_rust_stdlib_libs = [ "windows_link", "rustc_literal_escaper" ]
removed_rust_stdlib_libs = []
rust_bindgen_root = "F:/cr/bindgen-rt"   # host tool (x64)

# --- PGO + ThinLTO (the only lines that differ from out\arm-rt21) ---
use_thin_lto = true
chrome_pgo_phase = 2
# Must be explicit: build/config/compiler/pgo/BUILD.gn maps every Windows target_cpu other than arm64/x64 to "win32", so an
# empty pgo_data_path would silently pick Chrome's x86 profile (x86 MSVC mangling, matches nothing in ARM32 code).
pgo_data_path = "//chrome/build/pgo_profiles/venetium-arm32-20261026.profdata"
# ThinLTO codegen threads per link (Venetium build/config/compiler/BUILD.gn arg; upstream hard-codes "all" = 32 threads
# here). This server is shared-vCPU (-j8 measured fastest) with 32 GB RAM; chrome.dll's whole codegen runs in ONE link.
win_thin_lto_jobs = "8"
# Rust stays out of ThinLTO (native objects, exactly as in arm-rt21): rustc's bitcode triple is thumbv7a-PC-windows-msvc,
# clang's thumbv7-UNKNOWN-windows-msvc; a cross-language import warns "Linking two modules of different target triples"
# (IRMover), and every link has /WX. Cross-language inlining was measured as no gain.
toolchain_supports_rust_thin_lto = false

# v1.2: V8 builtins PGO with the x86 profile V8 ships for x86 and ARM (v8/BUILD.gn); the mksnapshot step warns, not
# aborts, on a builtin whose graph does not match (Venetium 0058).
v8_enable_builtins_optimization = true
clang_use_chrome_plugins = false   # rt2.x has no Chromium clang plugins
use_siso = false                   # we drive ninja
enable_precompiled_headers = false # V8SIM-2 §4 / TOOLCHAIN-ISSUES P1

# --- ARM-1 decision 9 (ARM-1-DECISIONS.md, GPU): ARM32 renders through ANGLE's D3D9 backend (Venetium 0021); SwiftShader and
# ANGLE's WebGPU/Dawn backend have no use there and are left out of the ARM build.
enable_swiftshader = false
angle_enable_wgpu = false
# ARM-1 §5 fix round (his decision 1, "completes 0021"): Dawn pulls SwiftShader on its own arg (third_party/dawn/src/dawn/
# native/BUILD.gn data_deps); with ui/gl's Windows data_deps gated by Venetium 0025, this takes SwiftShader out of the graph.
dawn_use_swiftshader = false
# --- TOOLCHAIN-ISSUES B4: FIXED in the fixed rt2.1 (LLVM 0017, Windows ARM32 WinEH). Venetium 0024 (libc++ no-exceptions) is
# dropped — libc++ carries its EH tables again. But DXC stays OFF on ARM32: this is a PLATFORM gap, not the B4 workaround.
# DEVICE-7-FIX-1 (his decision 2026-10-06): see out\arm-rt21\args.gn for the full note (no arm/dxil.dll exists).
dawn_use_built_dxc = false

# ---- venetium\args\venetium.gn (appended, as the build batches merge it) ----
# Venetium GN args (BATCH-VENETIUM-4 §2). Not a patch: the build batch merges this file into each output directory's args.gn.
# #1 Field-trial TESTING config off: non-Chrome-branded builds otherwise apply testing/variations/fieldtrial_testing_config.json at every start.
disable_fieldtrial_testing_config = true
# #9 Reporting API and Network Error Logging off (no background report uploads).
enable_reporting = false
# #10 On-device model service off (the ML model runtime process and its code).
use_on_device_model_service = false
# #15 JPEG XL decoder off.
enable_jxl_decoder = false
# D13 (his decision, 2026-10-02: "video and audio should be on"): proprietary codecs (H.264, AAC, ...) in every Venetium build.
proprietary_codecs = true
ffmpeg_branding = "Chrome"
# D15 (his decision, 2026-10-02: "official build, I agree with you"): use the real build/util/LASTCHANGE (Chromium's
# revision and year, venetium\deps\release-inputs.tsv) instead of LASTCHANGE.dummy.
use_dummy_lastchange = false
# v1.2 (his decision, 2026-10-15): an official build. Each output directory keeps its explicit use_thin_lto /
# chrome_pgo_phase / symbol_level / dcheck_always_on lines.
is_official_build = true
