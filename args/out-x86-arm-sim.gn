# BATCH-V8SIM-1 §3 — out\x86-arm-sim: V8's ARM simulator on a 32-bit x86 host (d8, mksnapshot, cctest, unittests).
# The server (V8SIM-2) recreates the directory from this file alone: `gn gen out\x86-arm-sim` with it as args.gn.
# (venetium\args\venetium.gn is appended below it, as the build batches merge it.)

# --- the simulator configuration (V8's own simulator-test setup: release + DCHECKs) ---
target_cpu = "x86"
v8_target_cpu = "arm"
is_debug = false
dcheck_always_on = true
symbol_level = 1
is_component_build = false

# --- toolchain (V8SIM-1 §0.3): rt2.1 and rustc-rt2.1, whose sysroot has the i686 std since RUSTC-3 ---
clang_base_path = "F:/cr/rt21-cr"   # fixed rt2.1 (BATCH-RT21-FIX-1): clang-cl d572c493…, lld-link 6e203038…, llvm-lib 9e197c48…
clang_version = "23"                 # rt2.1's lib/clang/23
rust_sysroot_absolute = "F:/cr/rustc-rt21"   # 158/158 = RUSTC-3-SYSROOT-MANIFEST.txt; on F: (find_std_rlibs.py relpath)
rustc_version = "rustc-1.100.0-nightly-bba531001-2026-09-20-rt2.1-31b4bac5e615"   # RUSTC-3 §3.1; new rustc_driver (Part R); no spaces
added_rust_stdlib_libs = [ "windows_link", "rustc_literal_escaper" ]   # same library lists as the x64 control
removed_rust_stdlib_libs = []
rust_bindgen_root = "F:/cr/bindgen-rt"   # the x64 control's Windows bindgen

# --- carried from the x64 control (out\x64-rt2) because they concern the toolchain, not the product ---
use_thin_lto = false
chrome_pgo_phase = 0
clang_use_chrome_plugins = false   # rt2.x has no Chromium clang plugins
use_siso = false                   # we drive ninja
# V8SIM-2 §4 (his decision 2026-09-29): no precompiled headers. Chromium 150 adds "-fmodule-name=..._Private" to every
# Windows clang compile (build/toolchain/win/toolchain.gni:221-224), and clang (18.1.8, 22.1.8, 23.1.1 alike) then builds the
# /Yc PCH as a C++20 module interface → "missing 'export module' declaration" (//base, the only PCH user). Chromium's bots
# never meet it: remote builds turn PCH off (build/config/pch.gni:18-20). The x64 and ARM server builds need the same line.
enable_precompiled_headers = false

# ---- venetium\args\venetium.gn (appended, as the build batches merge it) ----
# Venetium GN args (BATCH-VENETIUM-4 §2). Not a patch: the build batch merges this file into each output directory's args.gn.
# #1 Field-trial TESTING config off: non-Chrome-branded builds otherwise apply testing/variations/fieldtrial_testing_config.json at every start.
disable_fieldtrial_testing_config = true
# #9 Reporting API and Network Error Logging off (no background report uploads).
enable_reporting = false
# #10 On-device model service off (the ML model runtime process and its code).
use_on_device_model_service = false
# #15 JPEG XL decoder off.
enable_jxl_decoder = false
