--- a/lld/COFF/LTO.cpp
+++ b/lld/COFF/LTO.cpp
@@ -69,7 +69,12 @@
   // Use static reloc model on 32-bit x86 because it usually results in more
   // compact code, and because there are also known code generation bugs when
   // using the PIC model (see PR34306).
-  if (ctx.config.machine == COFF::IMAGE_FILE_MACHINE_I386)
+  // rt2.1: also on 32-bit ARM. clang compiles Windows ARM code with the static
+  // model, and Thumb-2 PIC is not representable in COFF: the /GS stack-guard
+  // load becomes a PC-relative movw/movt ("Cannot represent this expression"),
+  // so every stack-protected function failed LTO code generation.
+  if (ctx.config.machine == COFF::IMAGE_FILE_MACHINE_I386 ||
+      ctx.config.machine == COFF::IMAGE_FILE_MACHINE_ARMNT)
     c.RelocModel = Reloc::Static;
   else
     c.RelocModel = Reloc::PIC_;
