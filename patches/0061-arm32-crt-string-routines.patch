+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Venetium 0061: word-at-a-time memchr, memcmp, strchr, strcmp and strlen for
+// Windows ARM32.
+//
+// The static CRT's ARM32 versions of these (libvcruntime memchr/memcmp/strchr,
+// libucrt strlen/strcmp) are byte-at-a-time loops, and memcmp drops to one
+// byte per iteration as soon as either pointer is odd. Blink's string search,
+// V8's String.indexOf, URL and header parsing all lean on them. Each CRT
+// routine is a one-function object in its library, so defining the same
+// names in an object linked directly into the binary (this file, through
+// //build/config:common_deps) means the CRT member is never pulled in.
+//
+// Same results as the CRT, including strcmp's -1/0/1 and memcmp's byte
+// difference. Reads are aligned 32-bit words: memchr and memcmp never read
+// outside [p, p + n); strlen, strchr and strcmp may read up to 3 bytes past
+// the terminating NUL, but only inside the aligned word that holds it, so they
+// cannot cross into another page. Built with -fno-builtin so the compiler does
+// not turn these loops back into calls to themselves.
+
+#ifdef UNSAFE_BUFFERS_BUILD
+// Raw pointer walks over caller buffers are what these functions are.
+#pragma allow_unsafe_buffers
+#endif
+
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>  // The CRT's prototypes, so these definitions match them.
+
+typedef uint32_t __attribute__((__may_alias__)) venetium_word;
+typedef uint32_t __attribute__((__may_alias__, __aligned__(1)))
+venetium_unaligned_word;
+
+#define VENETIUM_ONES 0x01010101u
+#define VENETIUM_HIGHS 0x80808080u
+
+// Nonzero iff some byte of |v| is zero (exact: no false positives).
+static inline uint32_t VenetiumHasZeroByte(uint32_t v) {
+  return (v - VENETIUM_ONES) & ~v & VENETIUM_HIGHS;
+}
+
+// The difference of the first unequal bytes of two little-endian words that
+// differ.
+static inline int VenetiumFirstByteDiff(uint32_t x, uint32_t y) {
+  const unsigned shift = (unsigned)__builtin_ctz(x ^ y) & ~7u;
+  return (int)((x >> shift) & 0xff) - (int)((y >> shift) & 0xff);
+}
+
+void* memchr(const void* s, int c, size_t n) {
+  const unsigned char* p = (const unsigned char*)s;
+  const unsigned char ch = (unsigned char)c;
+  while (n && ((uintptr_t)p & 3)) {
+    if (*p == ch) {
+      return (void*)p;
+    }
+    ++p;
+    --n;
+  }
+  const uint32_t pattern = ch * VENETIUM_ONES;
+  while (n >= 8) {
+    const uint32_t a = ((const venetium_word*)p)[0] ^ pattern;
+    const uint32_t b = ((const venetium_word*)p)[1] ^ pattern;
+    if (VenetiumHasZeroByte(a) | VenetiumHasZeroByte(b)) {
+      break;
+    }
+    p += 8;
+    n -= 8;
+  }
+  while (n >= 4) {
+    if (VenetiumHasZeroByte(*(const venetium_word*)p ^ pattern)) {
+      break;
+    }
+    p += 4;
+    n -= 4;
+  }
+  while (n) {
+    if (*p == ch) {
+      return (void*)p;
+    }
+    ++p;
+    --n;
+  }
+  return NULL;
+}
+
+int memcmp(const void* a, const void* b, size_t n) {
+  const unsigned char* p = (const unsigned char*)a;
+  const unsigned char* q = (const unsigned char*)b;
+  // Align |p|; |q| is read with unaligned word loads (plain LDR, which ARMv7
+  // Windows allows on normal memory) whatever its alignment.
+  while (n && ((uintptr_t)p & 3)) {
+    if (*p != *q) {
+      return (int)*p - (int)*q;
+    }
+    ++p;
+    ++q;
+    --n;
+  }
+  while (n >= 4) {
+    const uint32_t x = *(const venetium_word*)p;
+    const uint32_t y = *(const venetium_unaligned_word*)q;
+    if (x != y) {
+      return VenetiumFirstByteDiff(x, y);
+    }
+    p += 4;
+    q += 4;
+    n -= 4;
+  }
+  while (n) {
+    if (*p != *q) {
+      return (int)*p - (int)*q;
+    }
+    ++p;
+    ++q;
+    --n;
+  }
+  return 0;
+}
+
+size_t strlen(const char* s) {
+  const char* p = s;
+  while ((uintptr_t)p & 3) {
+    if (!*p) {
+      return (size_t)(p - s);
+    }
+    ++p;
+  }
+  const venetium_word* w = (const venetium_word*)p;
+  while (!VenetiumHasZeroByte(*w)) {
+    ++w;
+  }
+  p = (const char*)w;
+  while (*p) {
+    ++p;
+  }
+  return (size_t)(p - s);
+}
+
+char* strchr(const char* s, int c) {
+  const char ch = (char)c;
+  while ((uintptr_t)s & 3) {
+    if (*s == ch) {
+      return (char*)s;
+    }
+    if (!*s) {
+      return NULL;
+    }
+    ++s;
+  }
+  const uint32_t pattern = (unsigned char)ch * VENETIUM_ONES;
+  const venetium_word* w = (const venetium_word*)s;
+  for (;;) {
+    const uint32_t v = *w;
+    if (VenetiumHasZeroByte(v) | VenetiumHasZeroByte(v ^ pattern)) {
+      break;
+    }
+    ++w;
+  }
+  for (s = (const char*)w;; ++s) {
+    if (*s == ch) {
+      return (char*)s;
+    }
+    if (!*s) {
+      return NULL;
+    }
+  }
+}
+
+int strcmp(const char* a, const char* b) {
+  const unsigned char* p = (const unsigned char*)a;
+  const unsigned char* q = (const unsigned char*)b;
+  if ((((uintptr_t)p ^ (uintptr_t)q) & 3) == 0) {
+    while ((uintptr_t)p & 3) {
+      if (*p != *q || !*p) {
+        goto done;
+      }
+      ++p;
+      ++q;
+    }
+    for (;;) {
+      const uint32_t x = *(const venetium_word*)p;
+      const uint32_t y = *(const venetium_word*)q;
+      if (x != y || VenetiumHasZeroByte(x)) {
+        break;
+      }
+      p += 4;
+      q += 4;
+    }
+  }
+  while (*p && *p == *q) {
+    ++p;
+    ++q;
+  }
+done:
+  // The CRT's strcmp returns exactly -1, 0 or 1.
+  return (*p > *q) - (*p < *q);
+}
