+// Venetium: its default features and switches. They are merged into the
+// browser process's command line once, after the chrome://flags choices have
+// been added to it and before the FeatureList is created, and only for a
+// feature or switch the user has not named: whatever the user passes with
+// --enable-features, --disable-features or --renderer-process-limit, or sets
+// in chrome://flags, always wins (a feature named in either list is left
+// alone, because a disabled entry would otherwise beat an enabled one).
+struct VenetiumFeatureDefault {
+  // As written in --enable-features / --disable-features.
+  const char* entry;
+  bool enable;
+};
+
+constexpr VenetiumFeatureDefault kVenetiumFeatureDefaults[] = {
+    // The back/forward cache keeps 2 pages (Chromium: 6).
+    {"BackForwardCacheSize:cache_size/2", true},
+    // Process sharing, the middle path: not a process for every site, but a
+    // site where the user types a password still gets its own process. (Not
+    // --disable-site-isolation-trials: that also stops new password sites
+    // from being isolated, see content::SiteInstance::StartIsolatingSite.)
+    {"SitePerProcess", false},
+    {"site-isolation-for-password-sites", true},
+    // Text recognition of image-only PDF pages: downloads and runs the Screen
+    // AI model as soon as such a PDF is opened.
+    {"ScreenAIOCREnabled", false},
+    // New tab page: no One Google Bar and no promo requests.
+    {"NtpOneGoogleBar", false},
+    {"NtpMiddleSlotPromo", false},
+    // Autofill: no form-type queries or votes sent to Google's server.
+    {"AutofillServerCommunication", false},
+};
+
+// A starting value, to be tuned on the tablet (Surface 2: Tegra 4, 2 GB).
+constexpr char kVenetiumRendererProcessLimit[] = "6";
+
+// Records what was added. A relaunch copies this process's command line, so
+// the next run takes these entries out again before merging afresh; otherwise
+// they would look like the user's own choices (and, for example, keep a
+// feature the user just enabled in chrome://flags disabled).
+constexpr char kVenetiumDefaultsSwitch[] = "venetium-defaults";
+
+// The feature name of an entry such as "*Name<Trial:param/value".
+std::string_view FeatureNameOf(std::string_view entry) {
+  if (!entry.empty() && entry.front() == '*') {
+    entry.remove_prefix(1);
+  }
+  return entry.substr(0, entry.find_first_of("<:"));
+}
+
+std::vector<std::string> SplitList(const std::string& value) {
+  return base::SplitString(value, ",", base::TRIM_WHITESPACE,
+                           base::SPLIT_WANT_NONEMPTY);
+}
+
+void AddVenetiumDefaults(base::CommandLine* command_line) {
+  const std::string enabled_before =
+      command_line->GetSwitchValueASCII(switches::kEnableFeatures);
+  const std::string disabled_before =
+      command_line->GetSwitchValueASCII(switches::kDisableFeatures);
+  std::vector<std::string> enabled = SplitList(enabled_before);
+  std::vector<std::string> disabled = SplitList(disabled_before);
+
+  // Take out what a previous run added (carried over by a relaunch).
+  for (const std::string& item : SplitList(
+           command_line->GetSwitchValueASCII(kVenetiumDefaultsSwitch))) {
+    if (item.size() < 3) {
+      continue;
+    }
+    const std::string value = item.substr(2);
+    if (base::StartsWith(item, "e=")) {
+      std::erase(enabled, value);
+    } else if (base::StartsWith(item, "d=")) {
+      std::erase(disabled, value);
+    } else if (base::StartsWith(item, "s=")) {
+      command_line->RemoveSwitch(value);
+    }
+  }
+  command_line->RemoveSwitch(kVenetiumDefaultsSwitch);
+
+  auto named = [&](std::string_view name) {
+    auto same = [name](const std::string& entry) {
+      return FeatureNameOf(entry) == name;
+    };
+    return std::ranges::any_of(enabled, same) ||
+           std::ranges::any_of(disabled, same);
+  };
+  std::vector<std::string> added;
+  for (const VenetiumFeatureDefault& d : kVenetiumFeatureDefaults) {
+    if (named(FeatureNameOf(d.entry))) {
+      continue;  // The user's choice wins.
+    }
+    (d.enable ? enabled : disabled).emplace_back(d.entry);
+    added.push_back(std::string(d.enable ? "e=" : "d=") + d.entry);
+  }
+  const std::string enabled_after = base::JoinString(enabled, ",");
+  const std::string disabled_after = base::JoinString(disabled, ",");
+  if (enabled_after != enabled_before) {
+    if (enabled.empty()) {
+      command_line->RemoveSwitch(switches::kEnableFeatures);
+    } else {
+      command_line->AppendSwitchASCII(switches::kEnableFeatures, enabled_after);
+    }
+  }
+  if (disabled_after != disabled_before) {
+    if (disabled.empty()) {
+      command_line->RemoveSwitch(switches::kDisableFeatures);
+    } else {
+      command_line->AppendSwitchASCII(switches::kDisableFeatures,
+                                      disabled_after);
+    }
+  }
+
+  if (!command_line->HasSwitch(switches::kRendererProcessLimit)) {
+    command_line->AppendSwitchASCII(switches::kRendererProcessLimit,
+                                    kVenetiumRendererProcessLimit);
+    added.push_back(std::string("s=") + switches::kRendererProcessLimit);
+  }
+  if (!added.empty()) {
+    command_line->AppendSwitchASCII(kVenetiumDefaultsSwitch,
+                                    base::JoinString(added, ","));
+  }
+}
