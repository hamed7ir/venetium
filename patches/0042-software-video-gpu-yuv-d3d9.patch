+// Venetium 0042: kill switch for uploading software-decoded (VP9 / AV1 /
+// software H.264) frames as single-channel YUV planes, converted to RGB on the
+// GPU, when the context lacks GL_EXT_texture_rg (ANGLE D3D9, e.g. Windows ARM32
+// / Tegra). Disabled, those frames go back to CPU YUV->RGB conversion.
+BASE_FEATURE(kVenetiumSoftwareVideoGpuYuv, base::FEATURE_ENABLED_BY_DEFAULT);
+
+// True when 8-bit single-channel planes can be used even though
+// MultiPlaneChannelFormatSupported() (which also gates canvas/WebGL uploads, left
+// unchanged) refuses them for lack of texture_rg: the GPU service then backs
+// them with LUMINANCE (ANGLE D3D9) or ALPHA textures, as Chromium 77 did.
+bool CanUseSingleChannelPlaneFallback(
+    viz::RasterContextProvider* raster_context_provider) {
+#if BUILDFLAG(IS_WIN)
+  if (!base::FeatureList::IsEnabled(kVenetiumSoftwareVideoGpuYuv)) {
+    return false;
+  }
+  const auto& caps = raster_context_provider->ContextCapabilities();
+  const auto& shared_image_caps =
+      raster_context_provider->SharedImageInterface()->GetCapabilities();
+  return !caps.texture_rg &&
+         shared_image_caps.supports_luminance_shared_images &&
+         !shared_image_caps.disable_one_component_textures;
+#else
+  return false;
+#endif
+}
