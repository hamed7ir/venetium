@@ -0,0 +1,105 @@
+#!/usr/bin/env python3
+# Copyright 2026 The Chromium Authors
+# Use of this source code is governed by a BSD-style license that can be
+# found in the LICENSE file.
+
+"""Assembles an armasm-syntax .asm file into a Windows ARM32 object.
+
+Venetium 0020. Crashpad's CaptureContext() for Windows ARM32
+(capture_context_win_arm.asm) is written in Microsoft's armasm dialect
+(EXPORT |name|, AREA, THUMB, EQU, PROC/ENDP). The Windows ARM32 'asm' tool of
+the toolchain is clang-cl, which assembles the GNU-syntax .S files of libvpx,
+webrtc, dav1d and ffmpeg but cannot read armasm syntax; armasm.exe in turn
+cannot read those .S files. So the .asm gets its own build step: this script
+runs armasm.exe, and the object it writes is listed in the sources of crashpad's
+util target (util/BUILD.gn), as upstream does with the prebuilt
+capture_context_win_arm64.obj.
+
+armasm.exe accepts /nologo, /Fo<file> and /I<dir>; it rejects /c, /D and
+/safeseh, so nothing but those is passed on.
+
+Usage:
+  run_armasm.py <environment-file> <output.obj> <input.asm> [/I<dir> ...]
+
+<environment-file> is the toolchain's environment block (environment.arm in the
+build directory, written by build/toolchain/win/setup_toolchain.py, the same file
+midl.gni and tool_wrapper.py use). Its PATH names the MSVC bin/HostX64/ARM
+directory that holds armasm.exe.
+"""
+
+import os
+import shutil
+import struct
+import subprocess
+import sys
+
+IMAGE_FILE_MACHINE_ARMNT = 0x01C4
+
+
+def ReadEnvironment(path):
+  """Reads an environment block as written by setup_toolchain.py: NUL separated
+  KEY=VALUE pairs, ended by two NULs."""
+  with open(path) as f:
+    data = f.read()
+  pairs = data[:-2].split('\0')
+  return dict(item.split('=', 1) for item in pairs)
+
+
+def FinalizeObject(obj_path):
+  """Checks that |obj_path| is a COFF object for ARMNT and sets its timestamp to
+  0 (armasm.exe embeds the time; the build is /Brepro and uses lld). Returns an
+  error string, or None."""
+  with open(obj_path, 'rb') as f:
+    data = bytearray(f.read())
+  if len(data) < 20:
+    return 'object is only %d bytes' % len(data)
+  machine, _sections, _timestamp = struct.unpack_from('<HHI', data, 0)
+  if machine != IMAGE_FILE_MACHINE_ARMNT:
+    return 'object machine is 0x%04X, expected ARMNT (0x%04X)' % (
+        machine, IMAGE_FILE_MACHINE_ARMNT)
+  struct.pack_into('<I', data, 4, 0)
+  with open(obj_path, 'wb') as f:
+    f.write(data)
+  return None
+
+
+def main(argv):
+  if len(argv) < 4:
+    sys.stderr.write(__doc__)
+    return 2
+  env_file, output, source = argv[1:4]
+  extra_args = argv[4:]
+
+  env = ReadEnvironment(env_file)
+  armasm = shutil.which('armasm.exe', path=env.get('PATH', ''))
+  if not armasm:
+    sys.stderr.write('armasm.exe not found on the PATH of %s\n' % env_file)
+    return 1
+
+  if os.path.exists(output):
+    os.remove(output)
+
+  command = [armasm, '/nologo', '/Fo' + output] + extra_args + [source]
+  process = subprocess.run(command,
+                           env=env,
+                           stdout=subprocess.PIPE,
+                           stderr=subprocess.STDOUT)
+  text = process.stdout.decode('utf-8', errors='replace')
+  if text.strip():
+    sys.stdout.write(text if text.endswith('\n') else text + '\n')
+  if process.returncode != 0:
+    return process.returncode
+
+  if not os.path.exists(output):
+    sys.stderr.write('armasm.exe reported success but wrote no %s\n' % output)
+    return 1
+  error = FinalizeObject(output)
+  if error:
+    os.remove(output)
+    sys.stderr.write('%s: %s\n' % (output, error))
+    return 1
+  return 0
+
+
+if __name__ == '__main__':
+  sys.exit(main(sys.argv))
