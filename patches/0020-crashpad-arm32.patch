+++ b/third_party/crashpad/crashpad/snapshot/win/cpu_context_win.cc
@@ -256,6 +256,39 @@ void InitializeARM64Context(const CONTEXT* context, CPUContextARM64* out) {
   }
 }
 
+#elif defined(ARCH_CPU_ARMEL)
+
+void InitializeARMContext(const CONTEXT* context, CPUContextARM* out) {
+  memset(out, 0, sizeof(*out));
+
+  LOG_IF(ERROR, !HasContextPart(context, CONTEXT_ARM)) << "non-arm context";
+
+  if (HasContextPart(context, CONTEXT_CONTROL)) {
+    out->cpsr = context->Cpsr;
+    out->pc = context->Pc;
+    out->lr = context->Lr;
+    out->sp = context->Sp;
+  }
+
+  if (HasContextPart(context, CONTEXT_INTEGER)) {
+    // CPUContextARM::regs holds r0-r10; r11 and r12 are fp and ip.
+    static_assert(offsetof(CONTEXT, R10) - offsetof(CONTEXT, R0) ==
+                      10 * sizeof(context->R0),
+                  "R0-R10 must be contiguous");
+    memcpy(&out->regs[0], &context->R0, 11 * sizeof(context->R0));
+    out->fp = context->R11;
+    out->ip = context->R12;
+  }
+
+  if (HasContextPart(context, CONTEXT_FLOATING_POINT)) {
+    static_assert(sizeof(out->vfp_regs.vfp) == sizeof(context->D),
+                  "types must be equivalent");
+    memcpy(&out->vfp_regs.vfp, &context->D, sizeof(out->vfp_regs.vfp));
+    out->vfp_regs.fpscr = context->Fpscr;
+    out->have_vfp_regs = true;
+  }
+}
+
 #else
 #error Unsupported Windows Arch
 #endif  // ARCH_CPU_X86
