+; WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+; See the License for the specific language governing permissions and
+; limitations under the License.
+
+; EXPORT the mangled name for `void crashpad::CaptureContext(CONTEXT*)`.
+; This name is specific to the MSVC ABI used by clang-cl on Windows.
+  EXPORT |?CaptureContext@crashpad@@YAXPAU_CONTEXT@@@Z|
+
+; Define the code section. READONLY is standard for code.
+  AREA |.text|, CODE, READONLY
+
+; Specify that the following code is Thumb-2. This is the standard for Win-on-ARM.
+  THUMB
+
+; Offsets into the ARM32 CONTEXT structure.
+; These values are derived from winnt.h for the ARM architecture.
+CONTEXT_R0   EQU 0x004
+CONTEXT_R1   EQU 0x008
+CONTEXT_R2   EQU 0x00c
+CONTEXT_R3   EQU 0x010
+CONTEXT_R4   EQU 0x014
+CONTEXT_R5   EQU 0x018
+CONTEXT_R6   EQU 0x01c
+CONTEXT_R7   EQU 0x020
+CONTEXT_R8   EQU 0x024
+CONTEXT_R9   EQU 0x028
+CONTEXT_R10  EQU 0x02c
+CONTEXT_R11  EQU 0x030  ; Frame Pointer (fp)
+CONTEXT_R12  EQU 0x034  ; Intra-Procedure-call scratch register (ip)
+CONTEXT_SP   EQU 0x038  ; Stack Pointer (r13)
+CONTEXT_LR   EQU 0x03c  ; Link Register (r14)
+CONTEXT_PC   EQU 0x040  ; Program Counter (r15)
+CONTEXT_CPSR EQU 0x044  ; Current Program Status Register
+
+
+|?CaptureContext@crashpad@@YAXPAU_CONTEXT@@@Z| PROC
+  ; The pointer to the CONTEXT structure is passed in r0, per ARM EABI.
+
+  ; --- Save General-Purpose Registers ---
+  ; We store r0-r12 into the CONTEXT structure.
+  ; Note: The original value of r0 from the caller is overwritten by the
+  ; context pointer argument. The value we save for r0 is this pointer.
+  ; This mirrors the behavior of the ARM64 version where "The original x0
+  ; can't be recovered".
+  str  r0, [r0, #CONTEXT_R0]
+  str  r1, [r0, #CONTEXT_R1]
+  str  r2, [r0, #CONTEXT_R2]
+  str  r3, [r0, #CONTEXT_R3]
+  str  r4, [r0, #CONTEXT_R4]
+  str  r5, [r0, #CONTEXT_R5]
+  str  r6, [r0, #CONTEXT_R6]
+  str  r7, [r0, #CONTEXT_R7]
+  str  r8, [r0, #CONTEXT_R8]
+  str  r9, [r0, #CONTEXT_R9]
+  str  r10, [r0, #CONTEXT_R10]
+  str  r11, [r0, #CONTEXT_R11]
+  str  r12, [r0, #CONTEXT_R12]
+
+  ; --- Save Control Registers ---
+  ; The Link Register (lr/r14) and Stack Pointer (sp/r13) must also be saved.
+  ; We use r1 as a scratch register to hold the value of SP.
+  mov  r1, sp
+  str  r1, [r0, #CONTEXT_SP]   ; Save current SP to context->Sp
+  str  lr, [r0, #CONTEXT_LR]   ; Save current LR to context->Lr
+
+  ; Save the "program counter". From the perspective of the captured context,
+  ; the PC is the return address of this function, which is in the Link Register.
+  str  lr, [r0, #CONTEXT_PC]   ; Save current LR to context->Pc
+
+  ; --- Save Processor State and Set ContextFlags ---
+  ; Get the Current Program Status Register (CPSR), which contains the NZCV flags.
+  mrs  r1, cpsr
+  str  r1, [r0, #CONTEXT_CPSR] ; Save CPSR to context->Cpsr
+
+  ; Set the ContextFlags field. The value is a combination of:
+  ; CONTEXT_ARM     (0x200000)
+  ; CONTEXT_CONTROL (0x000001)
+  ; CONTEXT_INTEGER (0x000002)
+  ; Total = 0x200003
+  ldr  r1, =0x200003
+  str  r1, [r0, #0]            ; Store flags at the start of the CONTEXT struct.
+
+  ; --- Cleanup and Return ---
+  ; Restore r1, which we used as a scratch register. This is good practice,
+  ; even though r1 is a caller-saved register.
+  ldr  r1, [r0, #CONTEXT_R1]
+
+  ; TODO(https://crashpad.chromium.org/bug/300): save floating-point registers
+  ; (VFP/NEON). This would involve checking CONTEXT_FLOATING_POINT and storing
+  ; the D registers and FPSCR.
+
+  ; Return to the caller.
+  bx   lr
+  ENDP
+
+  END
\ No newline at end of file
