diff --git a/build/toolchain/win/setup_toolchain.py b/build/toolchain/win/setup_toolchain.py
index e0b7c03..9971b9e 100644
--- a/build/toolchain/win/setup_toolchain.py
+++ b/build/toolchain/win/setup_toolchain.py
@@ -22,6 +22,8 @@ import gn_helpers
 
 SCRIPT_DIR = os.path.dirname(__file__)
 SDK_VERSION = '10.0.26100.0'
+# Venetium 0016 (D9): the last SDK that ships the ARM32 import libs (Lib/<ver>/um/arm, Lib/<ver>/ucrt/arm).
+ARM32_LIB_SDK_VERSION = '10.0.19041.0'
 MSVC_DIR = re.compile('^.*/VC/Tools/MSVC/[^/]+/include$')
 WINDOWS_KITS_DIR = re.compile(r'^(.*/Windows Kits/\d+/Include/[^/]+)/.*')
 
@@ -103,6 +105,20 @@ def _LoadEnvFromBat(args):
   return variables.decode(errors='ignore')
 
 
+def _FixupArm32SdkDirs(variables):
+  # vcvarsall.bat (amd64_arm, SDK_VERSION) puts Lib/SDK_VERSION/um/arm on LIB (it does not exist: the 26100 SDK ships no
+  # ARM32 import libs) and falls back to ARM32_LIB_SDK_VERSION for the UCRT include and lib directories. Keep the
+  # SDK_VERSION headers (D9); take the ARM32 import libs from ARM32_LIB_SDK_VERSION.
+  sep = '[' + chr(92) * 2 + '/]'  # regex class for a path separator: an escaped backslash, or a slash
+  end = '(?=;|' + chr(13) + '?$)'  # end of a LIB / INCLUDE entry
+  lib_dir = '(?i)(' + sep + 'lib' + sep + '+)' + re.escape(SDK_VERSION) + '(' + sep + '+um' + sep + 'arm)' + end
+  ucrt_include_dir = ('(?i)(' + sep + 'include' + sep + '+)' + re.escape(ARM32_LIB_SDK_VERSION) + '(' + sep + '+ucrt)' +
+                      end)
+  variables = re.sub(lib_dir, lambda m: m.group(1) + ARM32_LIB_SDK_VERSION + m.group(2), variables, flags=re.M)
+  variables = re.sub(ucrt_include_dir, lambda m: m.group(1) + SDK_VERSION + m.group(2), variables, flags=re.M)
+  return variables
+
+
 def _LoadToolchainEnv(cpu, toolchain_root, sdk_dir, target_store):
   """Returns a dictionary with environment variables that must be set while
   running binaries from the toolchain (e.g. INCLUDE and PATH for cl.exe)."""
@@ -191,6 +207,8 @@ def _LoadToolchainEnv(cpu, toolchain_root, sdk_dir, target_store):
     # packaged toolchain in build/vs_toolchain.py.
     args.append(SDK_VERSION)
     variables = _LoadEnvFromBat(args)
+    if cpu == 'arm':
+      variables = _FixupArm32SdkDirs(variables)
   return _ExtractImportantEnvironment(variables)
 
 
