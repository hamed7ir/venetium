+    // Venetium 0033: on a shader-model-2 device (the Tegra at D3D9) choose the strongest 2.x profile the caps allow, so a
+    // program that needs more than ps_2_0's 64 arithmetic slots compiles (ps_2_a / ps_2_b allow 512; section 2.4) instead of
+    // failing. Microsoft's profile requirements, checked against D3DCAPS9.PS20Caps / VS20Caps. Only reached when the device is
+    // SM2 (an SM3 device, like the x86 WARP control, keeps ps_3_0 / vs_3_0, as before). profileStream is unused now.
+    (void)profileStream;
+    std::string profile;
+    if (getMajorShaderModel() >= 3)
+    {
+        profile = (type == gl::ShaderType::Vertex) ? "vs_3_0" : "ps_3_0";
+    }
+    else if (type == gl::ShaderType::Vertex)
+    {
+        const D3DVSHADERCAPS2_0 &v = mDeviceCaps.VS20Caps;
+        if ((v.Caps & D3DVS20CAPS_PREDICATION) && v.DynamicFlowControlDepth >= 24 && v.NumTemps >= 13 &&
+            v.StaticFlowControlDepth >= 4)
+            profile = "vs_2_a";
+        else
+            profile = "vs_2_0";
+    }
+    else
+    {
+        const D3DPSHADERCAPS2_0 &p = mDeviceCaps.PS20Caps;
+        // Venetium 0033 (amended, DEVICE-7-FIX-1): the Surface 2's D3D9 driver advertises ps_2_a-class caps measured on the
+        // trip-6 d3dprobe - PS20Caps 0x19 (ARBITRARYSWIZZLE | NODEPENDENTREADLIMIT | NOTEXINSTRUCTIONLIMIT), 512
+        // NumInstructionSlots - and a 330-slot ps_2_a both compiles and is accepted by the driver (CreatePixelShader OK),
+        // while 330-slot ps_2_0 and ps_2_b are rejected. It does NOT advertise GRADIENTINSTRUCTIONS or PREDICATION (ps_2_a
+        // does not require them for our shaders), and the original gate's extra GRADIENTINSTRUCTIONS|PREDICATION|NumTemps>=22
+        // requirement is why trip-6 fell back to ps_2_0 and the 69-332-slot Skia programs had no headroom. Gate ps_2_a on
+        // exactly the caps the device has; ps_2_b only if a device shows the slots without the ps_2_a caps.
+        const DWORD kPs2aRequiredCaps = D3DPS20CAPS_ARBITRARYSWIZZLE | D3DPS20CAPS_NODEPENDENTREADLIMIT |
+                                        D3DPS20CAPS_NOTEXINSTRUCTIONLIMIT;
+        if (p.NumInstructionSlots >= 512 && (p.Caps & kPs2aRequiredCaps) == kPs2aRequiredCaps)
+            profile = "ps_2_a";
+        else if (p.NumInstructionSlots >= 512)
+            profile = "ps_2_b";
+        else
+            profile = "ps_2_0";
+    }
+    if (getMajorShaderModel() < 3 && !mSelectedProfileLogged)
+    {
+        mSelectedProfileLogged = true;
+        INFO() << "Venetium 0033: D3D9 SM2 device; this stage uses profile '" << profile << "' (PS20 slots "
+               << mDeviceCaps.PS20Caps.NumInstructionSlots << " temps " << mDeviceCaps.PS20Caps.NumTemps << " caps "
+               << mDeviceCaps.PS20Caps.Caps << "; VS20 temps " << mDeviceCaps.VS20Caps.NumTemps << " caps "
+               << mDeviceCaps.VS20Caps.Caps << ").";
+    }
 
     UINT flags = ANGLE_COMPILE_OPTIMIZATION_LEVEL;
 
