--- a/v8/src/execution/isolate.cc
+++ b/v8/src/execution/isolate.cc
@@ -205,7 +205,19 @@ namespace internal {
 #endif
 
 const uint8_t* DefaultEmbeddedBlobCode() {
+#if defined(V8_HOST_ARCH_ARM) && defined(V8_OS_WIN)
+  // The linker sets bit 0 (the Thumb bit) in the address of any symbol that
+  // lives in an executable section, so the raw address of the embedded blob is
+  // odd. The blob is A32 code: strip the bit so that every builtin entry point
+  // derived from it is even and runs in ARM state. This is keyed on the host
+  // architecture: isolate.cc also builds into the x86 mksnapshot, which has
+  // V8_TARGET_ARCH_ARM but an ordinary x86 data symbol here.
+  return reinterpret_cast<const uint8_t*>(
+      reinterpret_cast<uintptr_t>(v8_Default_embedded_blob_code_) &
+      ~uintptr_t{1});
+#else
   return v8_Default_embedded_blob_code_;
+#endif
 }
 uint32_t DefaultEmbeddedBlobCodeSize() {
   return v8_Default_embedded_blob_code_size_;
