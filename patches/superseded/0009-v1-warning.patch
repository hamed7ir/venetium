diff --git a/build/config/compiler/BUILD.gn b/build/config/compiler/BUILD.gn
index e1da114..4d47b15 100644
--- a/build/config/compiler/BUILD.gn
+++ b/build/config/compiler/BUILD.gn
@@ -1941,6 +1941,17 @@ config("default_warnings") {
       # New clang warnings usually go here during a roll
     ]
 
+    # Venetium V1 (TOOLCHAIN-ISSUES.md): our clang 23.1.1 (rt2, rt2.1)
+    # deprecates 'lifetime_capture_by(this)' in favour of
+    # 'lifetime_capture_by_this'; Chromium 150's pinned 23-init clang predates
+    # that. abseil's spinlock.h and mutex.h use the old spelling, so with
+    # -Werror every file that includes them fails. The warning has no group of
+    # its own, so this switch is the narrowest one; Chromium's own clang
+    # (clang_base_path == default_clang_base_path) is left untouched.
+    if (clang_base_path != default_clang_base_path) {
+      cflags_cc += [ "-Wno-deprecated-attributes" ]
+    }
+
     if (is_win) {
       # TODO(thakis): https://crbug.com/617318
