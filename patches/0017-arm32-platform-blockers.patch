 // Function that can be jumped midway into safely.
 __attribute__((naked)) int nop_sled() {
+#if defined(ARCH_CPU_ARMEL)
+  // 32-bit Arm has no "ret" instruction.
+  asm("nop\n"
+      "nop\n"
+      "bx lr\n");
+#else
   asm("nop\n"
       "nop\n"
       "ret\n");
+#endif
 }
 
