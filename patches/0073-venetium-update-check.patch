+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+// Venetium 0073: the GitHub update check. At most once every 7 days the browser
+// asks GitHub for the latest stable Venetium release and, when it is newer than
+// this build (BUILDFLAG(VENETIUM_RELEASE_TAG), from the GN arg
+// venetium_release_tag), shows an infobar with a link to the release page.
+// Off with --disable-venetium-update-check, and in builds without a tag.
+
+#ifndef CHROME_BROWSER_UI_STARTUP_VENETIUM_UPDATE_CHECK_H_
+#define CHROME_BROWSER_UI_STARTUP_VENETIUM_UPDATE_CHECK_H_
+
+#include <string_view>
+
+class PrefRegistrySimple;
+
+namespace venetium {
+
+// Registers the local state pref that keeps the time of the last successful
+// check.
+void RegisterUpdateCheckPrefs(PrefRegistrySimple* registry);
+
+// Starts the check once per browser process, if it is enabled and the last
+// successful check is 7 days old or more.
+void MaybeCheckForUpdate();
+
+// True when release tag `a` (like "v1.4" or "v1.3.2") is newer than `b`.
+bool IsNewerRelease(std::string_view a, std::string_view b);
+
+}  // namespace venetium
+
+#endif  // CHROME_BROWSER_UI_STARTUP_VENETIUM_UPDATE_CHECK_H_
