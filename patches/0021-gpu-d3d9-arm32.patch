         (angle_use_x11 || angle_use_wayland || angle_use_vulkan_display)) ||
        is_android || is_fuchsia || is_mac)
diff --git a/third_party/angle/src/libANGLE/renderer/d3d/d3d9/Renderer9.cpp b/third_party/angle/src/libANGLE/renderer/d3d/d3d9/Renderer9.cpp
