+++ b/third_party/angle/src/libANGLE/renderer/d3d/d3d9/Renderer9.cpp
@@ -68,7 +68,13 @@
 // Enable ANGLE_SUPPORT_SHADER_MODEL_2 if you wish devices with only shader model 2.
 // Such a device would not be conformant.
 #ifndef ANGLE_SUPPORT_SHADER_MODEL_2
-#    define ANGLE_SUPPORT_SHADER_MODEL_2 0
+// Venetium 0021: Windows ARM32 only. Its D3D9 devices (feature level 9_x GPUs) report pixel
+// shader 2.0, so accept PS 2.0 there; every other CPU keeps the stock floor of PS 3.0.
+#    if defined(_M_ARM)
+#        define ANGLE_SUPPORT_SHADER_MODEL_2 1
+#    else
+#        define ANGLE_SUPPORT_SHADER_MODEL_2 0
+#    endif
 #endif
 
