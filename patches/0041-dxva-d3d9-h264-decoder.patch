+// One output picture: an RGB render-target texture on ANGLE's D3D9 device,
+// opened by ANGLE through its share handle as an EGL pbuffer, bound once to a
+// GL texture that a SharedImage wraps. The pbuffer stays bound for the
+// SharedImage's whole life: in this tree's ANGLE, eglReleaseTexImage empties the
+// texture, and viz keeps its read access open across frames, so Chromium 77's
+// per-frame bind/release cannot be used.
+class DXVAVideoDecoder::PictureBuffer
+    : public base::RefCounted<DXVAVideoDecoder::PictureBuffer> {
+ public:
+  PictureBuffer() = default;
+  PictureBuffer(const PictureBuffer&) = delete;
+  PictureBuffer& operator=(const PictureBuffer&) = delete;
+
+  bool Init(CommandBufferHelper* helper,
+            IDirect3DDevice9Ex* device,
+            EGLConfig egl_config,
+            bool use_rgb_texture,
+            const gfx::Size& size) {
+    size_ = size;
+    gpu::SharedImageStub* stub = helper->GetSharedImageStub();
+    if (!stub || !stub->MakeContextCurrent(/*needs_gl=*/true)) {
+      LOG(ERROR) << "DXVAVideoDecoder: cannot make the GL context current";
+      return false;
+    }
+
+    HANDLE share_handle = nullptr;
+    HRESULT hr = device->CreateTexture(
+        size.width(), size.height(), 1, D3DUSAGE_RENDERTARGET,
+        use_rgb_texture ? D3DFMT_X8R8G8B8 : D3DFMT_A8R8G8B8, D3DPOOL_DEFAULT,
+        &texture_, &share_handle);
+    if (FAILED(hr) || !share_handle) {
+      LOG(ERROR) << "DXVAVideoDecoder: CreateTexture failed, hr=0x" << std::hex
+                 << hr;
+      return false;
+    }
+    hr = texture_->GetSurfaceLevel(0, &surface_);
+    if (FAILED(hr)) {
+      return false;
+    }
+
+    EGLDisplay display = gl::GLSurfaceEGL::GetGLDisplayEGL()->GetDisplay();
+    const EGLint attribs[] = {EGL_WIDTH,
+                              size.width(),
+                              EGL_HEIGHT,
+                              size.height(),
+                              EGL_TEXTURE_FORMAT,
+                              use_rgb_texture ? EGL_TEXTURE_RGB
+                                              : EGL_TEXTURE_RGBA,
+                              EGL_TEXTURE_TARGET,
+                              EGL_TEXTURE_2D,
+                              EGL_NONE};
+    EGLSurface pbuffer = eglCreatePbufferFromClientBuffer(
+        display, EGL_D3D_TEXTURE_2D_SHARE_HANDLE_ANGLE, share_handle,
+        egl_config, attribs);
+    if (pbuffer == EGL_NO_SURFACE) {
+      LOG(ERROR) << "DXVAVideoDecoder: eglCreatePbufferFromClientBuffer failed"
+                 << ", egl error 0x" << std::hex << eglGetError();
+      return false;
+    }
+
+    // A mutable texture (no glTexStorage): ANGLE refuses to bind a pbuffer to
+    // an immutable one.
+    gl::GLApi* api = gl::g_current_gl_context;
+    GLuint texture_id = 0;
+    {
+      gl::ScopedActiveTexture active_texture(GL_TEXTURE0);
+      gl::ScopedRestoreTexture restore_texture(api, GL_TEXTURE_2D);
+      api->glGenTexturesFn(1, &texture_id);
+      api->glBindTextureFn(GL_TEXTURE_2D, texture_id);
+      api->glTexParameteriFn(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+      api->glTexParameteriFn(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+      api->glTexParameteriFn(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S,
+                             GL_CLAMP_TO_EDGE);
+      api->glTexParameteriFn(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T,
+                             GL_CLAMP_TO_EDGE);
+      if (!eglBindTexImage(display, pbuffer, EGL_BACK_BUFFER)) {
+        LOG(ERROR) << "DXVAVideoDecoder: eglBindTexImage failed, egl error 0x"
+                   << std::hex << eglGetError();
+        api->glDeleteTexturesFn(1, &texture_id);
+        eglDestroySurface(display, pbuffer);
+        return false;
+      }
+    }
+
+    // From here on the SharedImage backing owns `texture_id` and releases the
+    // pbuffer before deleting it.
+    gpu::SharedImageInfo si_info(
+        viz::SinglePlaneFormat::kBGRA_8888, size, gfx::ColorSpace::CreateSRGB(),
+        gpu::SHARED_IMAGE_USAGE_GLES2_READ | gpu::SHARED_IMAGE_USAGE_RASTER_READ |
+            gpu::SHARED_IMAGE_USAGE_DISPLAY_READ,
+        "DXVAVideoDecoderPicture");
+    shared_image_ = stub->shared_image_interface()->CreateSharedImageForD3D9Video(
+        si_info, texture_id, base::BindOnce(&ReleasePbuffer, display, pbuffer));
+    if (!shared_image_) {
+      LOG(ERROR) << "DXVAVideoDecoder: CreateSharedImageForD3D9Video failed";
+      return false;
+    }
+    return true;
+  }
+
+  IDirect3DSurface9* d3d_surface() const { return surface_.Get(); }
+  const scoped_refptr<gpu::ClientSharedImage>& shared_image() const {
+    return shared_image_;
+  }
+  const gfx::Size& size() const { return size_; }
+  bool in_client_use() const { return in_client_use_; }
+  void set_in_client_use(bool in_client_use) { in_client_use_ = in_client_use; }
+
+ private:
+  friend class base::RefCounted<PictureBuffer>;
+  ~PictureBuffer() = default;
+
+  gfx::Size size_;
+  Microsoft::WRL::ComPtr<IDirect3DTexture9> texture_;
+  Microsoft::WRL::ComPtr<IDirect3DSurface9> surface_;
+  scoped_refptr<gpu::ClientSharedImage> shared_image_;
+  bool in_client_use_ = false;
+};
+
+// static
+std::unique_ptr<VideoDecoder> DXVAVideoDecoder::Create(
+    scoped_refptr<base::SingleThreadTaskRunner> gpu_task_runner,
+    std::unique_ptr<MediaLog> media_log,
+    const gpu::GpuPreferences& gpu_preferences,
+    const gpu::GpuDriverBugWorkarounds& gpu_workarounds,
+    base::RepeatingCallback<gpu::CommandBufferStub*()> get_stub_cb) {
+  auto get_helper_cb = base::BindRepeating(
+      CreateCommandBufferHelper, std::move(get_stub_cb),
+      base::MakeRefCounted<CommandBufferHelperHolder>(gpu_task_runner));
+  return base::WrapUnique<VideoDecoder>(
+      new DXVAVideoDecoder(std::move(gpu_task_runner), std::move(media_log),
+                           gpu_workarounds, std::move(get_helper_cb)));
+}
+
+// static
+SupportedVideoDecoderConfigs DXVAVideoDecoder::GetSupportedVideoDecoderConfigs(
+    const gpu::GpuPreferences& gpu_preferences,
+    const gpu::GpuDriverBugWorkarounds& gpu_workarounds) {
+  SupportedVideoDecoderConfigs configs;
+  if (gpu_preferences.disable_accelerated_video_decode ||
+      gpu_workarounds.disable_accelerated_h264_decode) {
+    return configs;
+  }
+  const gfx::Size max_size = ProbeMaxDecodeSize();
+  if (max_size.IsEmpty()) {
+    return configs;
+  }
+  // msmpeg2vdec handles Baseline, Main and High (not Extended), as in
+  // Chromium 77's kSupportedProfiles.
+  configs.emplace_back(H264PROFILE_BASELINE, H264PROFILE_MAIN, kMinDecodeSize,
+                       max_size, /*allow_encrypted=*/false,
+                       /*require_encrypted=*/false);
+  configs.emplace_back(H264PROFILE_HIGH, H264PROFILE_HIGH, kMinDecodeSize,
+                       max_size, /*allow_encrypted=*/false,
+                       /*require_encrypted=*/false);
+  return configs;
+}
+
+DXVAVideoDecoder::DXVAVideoDecoder(
+    scoped_refptr<base::SingleThreadTaskRunner> gpu_task_runner,
+    std::unique_ptr<MediaLog> media_log,
+    const gpu::GpuDriverBugWorkarounds& gpu_workarounds,
+    GetCommandBufferHelperCB get_helper_cb)
+    : media_log_(std::move(media_log)),
+      gpu_task_runner_(std::move(gpu_task_runner)),
+      gpu_workarounds_(gpu_workarounds),
+      get_helper_cb_(std::move(get_helper_cb)),
+      mailbox_release_helper_(
+          base::MakeRefCounted<D3D11VideoFrameMailboxReleaseHelper>(
+              media_log_->Clone(),
+              get_helper_cb_)) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+}
+
+DXVAVideoDecoder::~DXVAVideoDecoder() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (decoder_) {
+    decoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_END_STREAMING, 0);
+  }
+  // Picture buffers still held by the client stay alive through their release
+  // callbacks; their SharedImages are destroyed when those run.
+  picture_buffers_.clear();
+}
+
+VideoDecoderType DXVAVideoDecoder::GetDecoderType() const {
+  // Reuses the "VDA" type (only ChromeOS code special-cases it): this is
+  // Chromium 77's DXVA VideoDecodeAccelerator logic. chrome://media-internals
+  // shows it as VDAVideoDecoder.
+  return VideoDecoderType::kVda;
+}
+
+void DXVAVideoDecoder::Initialize(const VideoDecoderConfig& config,
+                                  bool low_delay,
+                                  CdmContext* cdm_context,
+                                  InitCB init_cb,
+                                  const OutputCB& output_cb,
+                                  const WaitingCB& waiting_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  TRACE_EVENT0("gpu", "DXVAVideoDecoder::Initialize");
+
+  // On D3D9 the media service lives on the GPU main thread (there is no
+  // dedicated media thread without a D3D11 device). GL, EGL and SharedImage
+  // work below relies on that.
+  if (!gpu_task_runner_->BelongsToCurrentThread()) {
+    std::move(init_cb).Run(DecoderStatus(
+        DecoderStatus::Codes::kFailedToCreateDecoder,
+        "DXVAVideoDecoder must run on the GPU main thread"));
+    return;
+  }
+  if (config.is_encrypted()) {
+    std::move(init_cb).Run(DecoderStatus::Codes::kUnsupportedEncryptionMode);
+    return;
+  }
+  if (config.codec() != VideoCodec::kH264 ||
+      (config.profile() != H264PROFILE_BASELINE &&
+       config.profile() != H264PROFILE_MAIN &&
+       config.profile() != H264PROFILE_HIGH)) {
+    std::move(init_cb).Run(DecoderStatus::Codes::kUnsupportedProfile);
+    return;
+  }
+
+  // Reinitialization drops everything in flight.
+  DCHECK(!decode_cb_);
+  pending_input_.Reset();
+  pending_output_.Reset();
+  draining_ = false;
+  decoder_.Reset();
+  device_manager_.Reset();
+
+  config_ = config;
+  output_cb_ = output_cb;
+  visible_rect_ = config.visible_rect();
+
+  DecoderStatus status = InitializeDecoder(config, low_delay);
+  if (!status.is_ok()) {
+    MEDIA_LOG(INFO, media_log_)
+        << "DXVAVideoDecoder: hardware H.264 unavailable ("
+        << status.message() << "); software decoding will be used";
+    state_ = State::kUninitialized;
+    decoder_.Reset();
+    device_manager_.Reset();
+    std::move(init_cb).Run(std::move(status));
+    return;
+  }
+
+  MEDIA_LOG(INFO, media_log_)
+      << "Video is supported by DXVAVideoDecoder (D3D9 + Media Foundation)";
+  state_ = State::kInitializing;
+  init_cb_ = std::move(init_cb);
+  if (release_mailbox_cb_) {
+    OnGpuInitComplete(true, release_mailbox_cb_);
+    return;
+  }
+  mailbox_release_helper_->Initialize(base::BindOnce(
+      &DXVAVideoDecoder::OnGpuInitComplete, weak_factory_.GetWeakPtr()));
+}
+
+DecoderStatus DXVAVideoDecoder::InitializeDecoder(
+    const VideoDecoderConfig& config,
+    bool low_delay) {
+  auto fail = [](const std::string& what, HRESULT hr = S_OK) {
+    std::string message = "DXVAVideoDecoder: " + what;
+    if (FAILED(hr)) {
+      message += base::StringPrintf(" (hr=0x%08lx)", static_cast<long>(hr));
+    }
+    return DecoderStatus(DecoderStatus::Codes::kFailedToCreateDecoder,
+                         message);
+  };
+
+  if (!InitializeMediaFoundation()) {
+    return fail("Media Foundation unavailable");
+  }
+
+  device_ = GetAngleD3D9DeviceEx();
+  if (!device_) {
+    return fail("no ANGLE D3D9Ex device");
+  }
+
+  gl::GLDisplayEGL* display = gl::GLSurfaceEGL::GetGLDisplayEGL();
+  if (!display || !display->ext->b_EGL_ANGLE_surface_d3d_texture_2d_share_handle) {
+    return fail("EGL_ANGLE_surface_d3d_texture_2d_share_handle unavailable");
+  }
+  if (!egl_config_) {
+    EGLConfig egl_config = nullptr;
+    bool use_rgb = true;
+    if (!ChooseEglConfig(display->GetDisplay(), &egl_config, &use_rgb)) {
+      return fail("no suitable pbuffer EGLConfig");
+    }
+    egl_config_ = egl_config;
+    use_rgb_texture_ = use_rgb;
+    MEDIA_LOG(INFO, media_log_)
+        << "DXVAVideoDecoder: pictures are "
+        << (use_rgb ? "X8R8G8B8 / EGL_TEXTURE_RGB"
+                    : "A8R8G8B8 / EGL_TEXTURE_RGBA");
+  }
+
+  // The decoder MFT comes from msmpeg2vdec.dll, preloaded before the sandbox
+  // (media::PreSandboxMediaFoundationInitialization).
+  HMODULE dll = ::GetModuleHandle(L"msmpeg2vdec.dll");
+  if (!dll) {
+    return fail("msmpeg2vdec.dll was not preloaded");
+  }
+  // Windows 7's 6.1.7140 crashes a lot (crbug.com/403440), as in Chromium 77.
+  std::unique_ptr<FileVersionInfo> version_info =
+      FileVersionInfo::CreateFileVersionInfoForModule(dll);
+  if (!version_info) {
+    return fail("cannot read the msmpeg2vdec.dll version");
+  }
+  if (version_info->file_version().find(u"6.1.7140") != std::u16string::npos) {
+    return fail("blocklisted msmpeg2vdec.dll 6.1.7140");
+  }
+
+  HRESULT hr = CreateCOMObjectFromDll(dll, __uuidof(CMSH264DecoderMFT),
+                                      IID_PPV_ARGS(&decoder_));
+  if (FAILED(hr)) {
+    return fail("cannot create CMSH264DecoderMFT", hr);
+  }
+
+  Microsoft::WRL::ComPtr<IMFAttributes> attributes;
+  hr = decoder_->GetAttributes(&attributes);
+  if (FAILED(hr)) {
+    return fail("IMFTransform::GetAttributes", hr);
+  }
+  UINT32 d3d_aware = 0;
+  hr = attributes->GetUINT32(MF_SA_D3D_AWARE, &d3d_aware);
+  if (FAILED(hr) || !d3d_aware) {
+    return fail("decoder MFT is not D3D aware", hr);
+  }
+  hr = attributes->SetUINT32(kCodecApiAVDecVideoAccelerationH264, TRUE);
+  if (FAILED(hr)) {
+    return fail("cannot enable DXVA H.264 acceleration", hr);
+  }
+  if (low_delay) {
+    attributes->SetUINT32(kCodecApiAVLowLatencyMode, TRUE);
+  }
+  attributes->SetUINT32(MF_SA_MINIMUM_OUTPUT_SAMPLE_COUNT, kMinOutputSamples);
+  attributes->SetUINT32(MF_SA_MINIMUM_OUTPUT_SAMPLE_COUNT_PROGRESSIVE,
+                        kMinOutputSamples);
+
+  // Decode on ANGLE's own D3D9Ex device (created D3DCREATE_MULTITHREADED), as
+  // Chromium 77 did whenever ANGLE ran on D3D9: decoder surfaces, the
+  // StretchRect and ANGLE's draws then share one in-order command stream, so no
+  // cross-device synchronization is needed.
+  hr = DXVA2CreateDirect3DDeviceManager9(&device_manager_reset_token_,
+                                         &device_manager_);
+  if (FAILED(hr)) {
+    return fail("DXVA2CreateDirect3DDeviceManager9", hr);
+  }
+  hr = device_manager_->ResetDevice(device_.Get(), device_manager_reset_token_);
+  if (FAILED(hr)) {
+    return fail("IDirect3DDeviceManager9::ResetDevice", hr);
+  }
+  hr = decoder_->ProcessMessage(
+      MFT_MESSAGE_SET_D3D_MANAGER,
+      reinterpret_cast<ULONG_PTR>(device_manager_.Get()));
+  if (FAILED(hr)) {
+    return fail("MFT rejected the D3D9 device manager (no DXVA H.264)", hr);
+  }
+
+  Microsoft::WRL::ComPtr<IMFMediaType> input_type;
+  hr = MFCreateMediaType(&input_type);
+  if (FAILED(hr)) {
+    return fail("MFCreateMediaType", hr);
+  }
+  input_type->SetGUID(MF_MT_MAJOR_TYPE, MFMediaType_Video);
+  input_type->SetGUID(MF_MT_SUBTYPE, MFVideoFormat_H264);
+  input_type->SetUINT32(MF_MT_INTERLACE_MODE,
+                        MFVideoInterlace_MixedInterlaceOrProgressive);
+  hr = decoder_->SetInputType(0, input_type.Get(), 0);
+  if (FAILED(hr)) {
+    return fail("SetInputType(H.264)", hr);
+  }
+  if (!SetOutputTypeNV12()) {
+    return fail("decoder offers no NV12 output");
+  }
+
+  MFT_INPUT_STREAM_INFO input_info = {};
+  hr = decoder_->GetInputStreamInfo(0, &input_info);
+  if (FAILED(hr)) {
+    return fail("GetInputStreamInfo", hr);
+  }
+  input_min_size_ = input_info.cbSize;
+  input_alignment_ = input_info.cbAlignment;
+
+  // With DXVA active the MFT allocates its own (D3D surface) output samples.
+  // Chromium 77 CHECKed this (0x107); here it is a soft failure, so a driver
+  // that silently falls back to software decode in the MFT just means the
+  // regular software decoders are used instead.
+  MFT_OUTPUT_STREAM_INFO output_info = {};
+  hr = decoder_->GetOutputStreamInfo(0, &output_info);
+  if (FAILED(hr)) {
+    return fail("GetOutputStreamInfo", hr);
+  }
+  if (!(output_info.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES)) {
+    return fail(base::StringPrintf(
+        "MFT is not decoding through DXVA (output flags 0x%lx)",
+        static_cast<unsigned long>(output_info.dwFlags)));
+  }
+
+  hr = decoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_BEGIN_STREAMING, 0);
+  if (FAILED(hr)) {
+    return fail("MFT_MESSAGE_NOTIFY_BEGIN_STREAMING", hr);
+  }
+  hr = decoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+  if (FAILED(hr)) {
+    return fail("MFT_MESSAGE_NOTIFY_START_OF_STREAM", hr);
+  }
+  return DecoderStatus::Codes::kOk;
+}
+
+bool DXVAVideoDecoder::SetOutputTypeNV12() {
+  for (DWORD i = 0;; ++i) {
+    Microsoft::WRL::ComPtr<IMFMediaType> type;
+    HRESULT hr = decoder_->GetOutputAvailableType(0, i, &type);
+    if (hr == MF_E_NO_MORE_TYPES || FAILED(hr)) {
+      return false;
+    }
+    GUID subtype = GUID_NULL;
+    if (FAILED(type->GetGUID(MF_MT_SUBTYPE, &subtype)) ||
+        subtype != MFVideoFormat_NV12) {
+      continue;
+    }
+    if (FAILED(decoder_->SetOutputType(0, type.Get(), 0))) {
+      return false;
+    }
+    UpdateVisibleRect();
+    return true;
+  }
+}
+
+void DXVAVideoDecoder::UpdateVisibleRect() {
+  Microsoft::WRL::ComPtr<IMFMediaType> type;
+  if (FAILED(decoder_->GetOutputCurrentType(0, &type))) {
+    return;
+  }
+  MFVideoArea area = {};
+  if (SUCCEEDED(type->GetBlob(MF_MT_MINIMUM_DISPLAY_APERTURE,
+                              reinterpret_cast<UINT8*>(&area), sizeof(area),
+                              nullptr)) &&
+      area.Area.cx > 0 && area.Area.cy > 0) {
+    visible_rect_ = gfx::Rect(area.OffsetX.value, area.OffsetY.value,
+                              area.Area.cx, area.Area.cy);
+    return;
+  }
+  UINT32 width = 0;
+  UINT32 height = 0;
+  if (SUCCEEDED(MFGetAttributeSize(type.Get(), MF_MT_FRAME_SIZE, &width,
+                                   &height)) &&
+      width && height) {
+    visible_rect_ = gfx::Rect(width, height);
+  }
+}
+
+void DXVAVideoDecoder::OnGpuInitComplete(
+    bool success,
+    D3D11VideoFrameMailboxReleaseHelper::ReleaseMailboxCB release_mailbox_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (!init_cb_) {
+    return;
+  }
+  if (!success) {
+    state_ = State::kError;
+    std::move(init_cb_).Run(DecoderStatus(
+        DecoderStatus::Codes::kFailedToCreateDecoder,
+        "DXVAVideoDecoder: could not initialize the GPU-side release helper"));
+    return;
+  }
+  release_mailbox_cb_ = std::move(release_mailbox_cb);
+  state_ = State::kRunning;
+  std::move(init_cb_).Run(DecoderStatus::Codes::kOk);
+}
+
+void DXVAVideoDecoder::Decode(scoped_refptr<DecoderBuffer> buffer,
+                              DecodeCB decode_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  TRACE_EVENT0("gpu", "DXVAVideoDecoder::Decode");
+  DCHECK(!decode_cb_) << "GetMaxDecodeRequests() is 1";
+
+  decode_cb_ = base::BindPostTaskToCurrentDefault(std::move(decode_cb));
+  if (state_ != State::kRunning) {
+    CompleteDecode(DecoderStatus::Codes::kPlatformDecodeFailure);
+    return;
+  }
+
+  if (buffer->end_of_stream()) {
+    draining_ = true;
+    decoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0);
+    HRESULT hr = decoder_->ProcessMessage(MFT_MESSAGE_COMMAND_DRAIN, 0);
+    if (FAILED(hr)) {
+      return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                         "MFT_MESSAGE_COMMAND_DRAIN", hr);
+    }
+    DoDecode();
+    return;
+  }
+
+  base::span<const uint8_t> data(*buffer);
+  Microsoft::WRL::ComPtr<IMFSample> sample = CreateEmptySampleWithBuffer(
+      std::max<uint32_t>(input_min_size_, data.size()), input_alignment_);
+  if (!sample) {
+    return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                       "CreateEmptySampleWithBuffer");
+  }
+  Microsoft::WRL::ComPtr<IMFMediaBuffer> media_buffer;
+  HRESULT hr = sample->GetBufferByIndex(0, &media_buffer);
+  if (FAILED(hr)) {
+    return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                       "IMFSample::GetBufferByIndex", hr);
+  }
+  BYTE* destination = nullptr;
+  DWORD max_length = 0;
+  hr = media_buffer->Lock(&destination, &max_length, nullptr);
+  if (FAILED(hr) || max_length < data.size()) {
+    return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                       "IMFMediaBuffer::Lock", hr);
+  }
+  std::copy(data.begin(), data.end(), destination);
+  media_buffer->Unlock();
+  media_buffer->SetCurrentLength(data.size());
+  sample->SetSampleTime(TimeDeltaToMfTime(buffer->timestamp()));
+
+  pending_input_ = std::move(sample);
+  DoDecode();
+}
+
+void DXVAVideoDecoder::DoDecode() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  TRACE_EVENT0("gpu", "DXVAVideoDecoder::DoDecode");
+  int stream_changes = 0;
+  int null_samples = 0;
+  while (state_ == State::kRunning) {
+    // A held sample goes first; while it waits for a picture buffer, nothing
+    // else is pulled (the MFT recycles its output surfaces).
+    if (pending_output_) {
+      if (!OutputSample(pending_output_)) {
+        return;
+      }
+      pending_output_.Reset();
+      continue;
+    }
+
+    if (pending_input_) {
+      HRESULT hr = decoder_->ProcessInput(0, pending_input_.Get(), 0);
+      if (SUCCEEDED(hr)) {
+        pending_input_.Reset();
+        CompleteDecode(DecoderStatus::Codes::kOk);
+      } else if (hr != MF_E_NOTACCEPTING) {
+        return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                           "IMFTransform::ProcessInput", hr);
+      }
+      // On MF_E_NOTACCEPTING, drain output first, then retry the input.
+    }
+
+    MFT_OUTPUT_DATA_BUFFER output = {};
+    DWORD status = 0;
+    HRESULT hr = decoder_->ProcessOutput(0, 1, &output, &status);
+    if (output.pEvents) {
+      output.pEvents->Release();
+    }
+    Microsoft::WRL::ComPtr<IMFSample> sample;
+    sample.Attach(output.pSample);
+
+    if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT) {
+      if (pending_input_) {
+        // Neither accepting input nor producing output: give up rather than
+        // spin.
+        return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                           "MFT neither accepts input nor produces output");
+      }
+      if (draining_) {
+        draining_ = false;
+        decoder_->ProcessMessage(MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+        CompleteDecode(DecoderStatus::Codes::kOk);
+      }
+      return;
+    }
+    if (hr == MF_E_TRANSFORM_STREAM_CHANGE) {
+      if (++stream_changes > kMaxStreamChanges || !SetOutputTypeNV12()) {
+        return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                           "cannot renegotiate NV12 output after a stream "
+                           "change");
+      }
+      continue;
+    }
+    if (FAILED(hr)) {
+      // Chromium 77 ignored a spurious E_FAIL here (crbug.com/839057, some
+      // desktop drivers). Tolerate it only when nothing waits on this pass (no
+      // pending input, no drain), so it can never leave a Decode() unanswered.
+      if (hr == E_FAIL && !pending_input_ && !draining_) {
+        DVLOG(1) << "DXVAVideoDecoder: ignoring E_FAIL from ProcessOutput";
+        return;
+      }
+      return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                         "IMFTransform::ProcessOutput", hr);
+    }
+    if (!sample) {
+      // S_OK without a sample breaks the MFT contract (it provides samples);
+      // bounded so a misbehaving MFT cannot spin the GPU main thread.
+      if (++null_samples > kMaxNullSamples) {
+        return NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                           "MFT returned success without a sample");
+      }
+      continue;
+    }
+    if (!OutputSample(sample)) {
+      pending_output_ = std::move(sample);
+      return;
+    }
+  }
+}
+
+bool DXVAVideoDecoder::OutputSample(Microsoft::WRL::ComPtr<IMFSample> sample) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  TRACE_EVENT0("gpu", "DXVAVideoDecoder::OutputSample");
+
+  Microsoft::WRL::ComPtr<IMFMediaBuffer> media_buffer;
+  HRESULT hr = sample->GetBufferByIndex(0, &media_buffer);
+  Microsoft::WRL::ComPtr<IDirect3DSurface9> surface;
+  if (SUCCEEDED(hr)) {
+    hr = MFGetService(media_buffer.Get(), MR_BUFFER_SERVICE,
+                      IID_PPV_ARGS(&surface));
+  }
+  if (FAILED(hr) || !surface) {
+    NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                "no D3D9 surface in the output sample", hr);
+    return true;
+  }
+  D3DSURFACE_DESC desc = {};
+  surface->GetDesc(&desc);
+  const gfx::Size coded_size(desc.Width, desc.Height);
+  if (!EnsurePictureBuffers(coded_size)) {
+    NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                "cannot create picture buffers");
+    return true;
+  }
+  scoped_refptr<PictureBuffer> picture_buffer = GetFreePictureBuffer();
+  if (!picture_buffer) {
+    return false;
+  }
+
+  // NV12 -> RGB on the GPU (driver colour matrix). Same device as ANGLE, so
+  // this is ordered before any draw that samples the picture.
+  hr = device_->StretchRect(surface.Get(), nullptr,
+                            picture_buffer->d3d_surface(), nullptr,
+                            D3DTEXF_NONE);
+  if (FAILED(hr)) {
+    NotifyError(DecoderStatus::Codes::kPlatformDecodeFailure,
+                "StretchRect (NV12 -> RGB)", hr);
+    return true;
+  }
+
+  LONGLONG sample_time = 0;
+  sample->GetSampleTime(&sample_time);
+
+  gfx::Rect visible_rect = visible_rect_;
+  if (visible_rect.IsEmpty() || !gfx::Rect(coded_size).Contains(visible_rect)) {
+    visible_rect = gfx::IntersectRects(config_.visible_rect(),
+                                       gfx::Rect(coded_size));
+    if (visible_rect.IsEmpty()) {
+      visible_rect = gfx::Rect(coded_size);
+    }
+  }
+  const gfx::Size natural_size =
+      config_.aspect_ratio().GetNaturalSize(visible_rect);
+
+  const scoped_refptr<gpu::ClientSharedImage>& shared_image =
+      picture_buffer->shared_image();
+  // XRGB: the frame is opaque, so whatever alpha the driver's NV12 -> RGB
+  // conversion leaves in the texture is never blended.
+  scoped_refptr<VideoFrame> frame = VideoFrame::WrapSharedImage(
+      PIXEL_FORMAT_XRGB, shared_image, shared_image->creation_sync_token(),
+      VideoFrame::ReleaseMailboxCB(), visible_rect, natural_size,
+      MfTimeToTimeDelta(sample_time));
+  if (!frame) {
+    NotifyError(DecoderStatus::Codes::kFailedToGetVideoFrame,
+                "VideoFrame::WrapSharedImage");
+    return true;
+  }
+
+  picture_buffer->set_in_client_use(true);
+  auto wait_complete_cb = base::BindPostTaskToCurrentDefault(
+      base::BindOnce(&DXVAVideoDecoder::ReceivePictureBufferFromClient,
+                     weak_factory_.GetWeakPtr(), picture_buffer));
+  frame->SetReleaseMailboxCB(
+      base::BindOnce(release_mailbox_cb_, std::move(wait_complete_cb)));
+  frame->metadata().power_efficient = true;
+  frame->metadata().allow_overlay = false;
+  frame->set_color_space(gfx::ColorSpace::CreateSRGB());
+  output_cb_.Run(std::move(frame));
+  return true;
+}
+
+bool DXVAVideoDecoder::EnsurePictureBuffers(const gfx::Size& size) {
+  if (!picture_buffers_.empty() && picture_buffers_.front()->size() == size) {
+    return true;
+  }
+  // Buffers the client still holds stay alive through their release callbacks.
+  picture_buffers_.clear();
+  scoped_refptr<CommandBufferHelper> helper = get_helper_cb_.Run();
+  if (!helper) {
+    return false;
+  }
+  for (size_t i = 0; i < kNumPictureBuffers; ++i) {
+    auto picture_buffer = base::MakeRefCounted<PictureBuffer>();
+    if (!picture_buffer->Init(helper.get(), device_.Get(),
+                              static_cast<EGLConfig>(egl_config_),
+                              use_rgb_texture_, size)) {
+      picture_buffers_.clear();
+      return false;
+    }
+    picture_buffers_.push_back(std::move(picture_buffer));
+  }
+  return true;
+}
+
+scoped_refptr<DXVAVideoDecoder::PictureBuffer>
+DXVAVideoDecoder::GetFreePictureBuffer() {
+  for (const auto& picture_buffer : picture_buffers_) {
+    if (!picture_buffer->in_client_use()) {
+      return picture_buffer;
+    }
+  }
+  return nullptr;
+}
+
+void DXVAVideoDecoder::ReceivePictureBufferFromClient(
+    scoped_refptr<PictureBuffer> buffer) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  buffer->set_in_client_use(false);
+  DoDecode();
+}
+
+void DXVAVideoDecoder::Reset(base::OnceClosure reset_cb) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  TRACE_EVENT0("gpu", "DXVAVideoDecoder::Reset");
+  pending_input_.Reset();
+  pending_output_.Reset();
+  draining_ = false;
+  CompleteDecode(DecoderStatus::Codes::kAborted);
+  if (decoder_ && state_ == State::kRunning) {
+    decoder_->ProcessMessage(MFT_MESSAGE_COMMAND_FLUSH, 0);
+  }
+  // CompleteDecode() posted, so the aborted decode callback runs first.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                           std::move(reset_cb));
+}
+
+bool DXVAVideoDecoder::NeedsBitstreamConversion() const {
+  // msmpeg2vdec wants Annex B with SPS/PPS in band.
+  return true;
+}
+
+bool DXVAVideoDecoder::CanReadWithoutStalling() const {
+  if (picture_buffers_.empty()) {
+    return true;
+  }
+  return std::any_of(picture_buffers_.begin(), picture_buffers_.end(),
+                     [](const auto& b) { return !b->in_client_use(); });
+}
+
+int DXVAVideoDecoder::GetMaxDecodeRequests() const {
+  return 1;
+}
+
+bool DXVAVideoDecoder::FramesHoldExternalResources() const {
+  return true;
+}
+
+void DXVAVideoDecoder::CompleteDecode(DecoderStatus status) {
+  if (decode_cb_) {
+    // `decode_cb_` was wrapped with BindPostTaskToCurrentDefault, so this never
+    // runs it re-entrantly from inside Decode().
+    std::move(decode_cb_).Run(std::move(status));
+  }
+}
+
+void DXVAVideoDecoder::NotifyError(DecoderStatus status,
+                                   const char* what,
+                                   HRESULT hr) {
+  MEDIA_LOG(ERROR, media_log_)
+      << "DXVAVideoDecoder: " << what << " failed"
+      << (FAILED(hr) ? base::StringPrintf(", hr=0x%08lx", static_cast<long>(hr))
+                     : std::string());
+  state_ = State::kError;
+  pending_input_.Reset();
+  pending_output_.Reset();
+  draining_ = false;
+  CompleteDecode(std::move(status));
+}
