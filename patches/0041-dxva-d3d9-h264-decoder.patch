+// GUIDs copied from the Windows SDK 10.0.26100 headers, so this file does not
+// depend on which import library happens to define them.
+// dxva2api.h: DXVA2_ModeH264_E / DXVA2_ModeH264_F (H.264 VLD, no FGT / FGT).
+constexpr GUID kDxva2ModeH264E = {
+    0x1b81be68,
+    0xa0c7,
+    0x11d3,
+    {0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5}};
+constexpr GUID kDxva2ModeH264F = {
+    0x1b81be69,
+    0xa0c7,
+    0x11d3,
+    {0xb9, 0x84, 0x00, 0xc0, 0x4f, 0x2e, 0x73, 0xc5}};
+// codecapi.h: CODECAPI_AVDecVideoAcceleration_H264, CODECAPI_AVLowLatencyMode.
+constexpr GUID kCodecApiAVDecVideoAccelerationH264 = {
+    0xf7db8a2f,
+    0x4f48,
+    0x4ee8,
+    {0xae, 0x31, 0x8b, 0x6e, 0xbe, 0x55, 0x8a, 0xe2}};
+constexpr GUID kCodecApiAVLowLatencyMode = {
+    0x9c27891a,
+    0xed7a,
+    0x40e1,
+    {0x88, 0xe8, 0xb2, 0x27, 0x27, 0xa0, 0x24, 0xee}};
+
+constexpr D3DFORMAT kNV12 =
