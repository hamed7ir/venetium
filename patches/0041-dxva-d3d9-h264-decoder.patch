+// Mimics CoCreateInstance without initializing COM on the GPU main thread
+// (Chromium 77, dxva_video_decode_accelerator_win.cc CreateCOMObjectFromDll).
+HRESULT CreateCOMObjectFromDll(HMODULE dll,
+                               const CLSID& clsid,
+                               const IID& iid,
+                               void** object) {
+  if (!dll || !object) {
+    return E_INVALIDARG;
+  }
+  using GetClassObject =
+      HRESULT(WINAPI*)(const CLSID& clsid, const IID& iid, void** object);
+  auto get_class_object = reinterpret_cast<GetClassObject>(
+      ::GetProcAddress(dll, "DllGetClassObject"));
+  if (!get_class_object) {
+    return E_FAIL;
+  }
+  Microsoft::WRL::ComPtr<IClassFactory> factory;
+  HRESULT hr = get_class_object(clsid, IID_PPV_ARGS(&factory));
+  if (FAILED(hr)) {
+    return hr;
+  }
+  return factory->CreateInstance(nullptr, iid, object);
+}
