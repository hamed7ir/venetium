+Microsoft::WRL::ComPtr<IDirect3DDevice9Ex> GetAngleD3D9DeviceEx() {
+  Microsoft::WRL::ComPtr<IDirect3DDevice9> device =
+      gl::QueryD3D9DeviceObjectFromANGLE();
+  Microsoft::WRL::ComPtr<IDirect3DDevice9Ex> device_ex;
+  if (!device || FAILED(device.As(&device_ex))) {
+    return nullptr;
+  }
+  return device_ex;
+}
