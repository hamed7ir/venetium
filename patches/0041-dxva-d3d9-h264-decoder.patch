+// Picks the pbuffer EGLConfig the way Chromium 77 did: 8-bit RGB, no alpha,
+// pbuffer-capable; RGB binding decides X8R8G8B8 vs A8R8G8B8 textures.
+bool ChooseEglConfig(EGLDisplay display,
+                     EGLConfig* config_out,
+                     bool* use_rgb_out) {
+  const EGLint attribs[] = {EGL_BUFFER_SIZE,  32, EGL_RED_SIZE,     8,
+                            EGL_GREEN_SIZE,   8,  EGL_BLUE_SIZE,    8,
+                            EGL_SURFACE_TYPE, EGL_PBUFFER_BIT,  EGL_ALPHA_SIZE,
+                            0,                EGL_NONE};
+  EGLint num_configs = 0;
+  if (!eglChooseConfig(display, attribs, nullptr, 0, &num_configs) ||
+      num_configs <= 0) {
+    return false;
+  }
+  std::vector<EGLConfig> configs(num_configs);
+  if (!eglChooseConfig(display, attribs, configs.data(), num_configs,
+                       &num_configs) ||
+      num_configs <= 0) {
+    return false;
+  }
+  EGLConfig chosen = configs[0];
+  for (EGLint i = 0; i < num_configs; ++i) {
+    EGLint red_bits = 0;
+    eglGetConfigAttrib(display, configs[i], EGL_RED_SIZE, &red_bits);
+    if (red_bits == 8) {
+      chosen = configs[i];
+      break;
+    }
+  }
+  EGLint bind_rgb = EGL_TRUE;
+  eglGetConfigAttrib(display, chosen, EGL_BIND_TO_TEXTURE_RGB, &bind_rgb);
+  *config_out = chosen;
+  *use_rgb_out = bind_rgb == EGL_TRUE;
+  return true;
+}
+
+// Runs from ~GLTextureImageBacking, before the GL texture is deleted.
+void ReleasePbuffer(EGLDisplay display, EGLSurface pbuffer, bool have_context) {
+  if (have_context) {
+    eglReleaseTexImage(display, pbuffer, EGL_BACK_BUFFER);
+  }
+  eglDestroySurface(display, pbuffer);
+}
