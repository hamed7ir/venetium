+// Probes this GPU process's ANGLE D3D9 device once: msmpeg2vdec.dll preloaded,
+// NV12 -> X8R8G8B8 StretchRect supported, a DXVA2 H.264 VLD mode with NV12
+// render targets, and the largest of 1920x1088 / 1280x720 the driver offers a
+// decoder configuration for. Returns an empty size if any step fails. Tegra 3
+// and Tegra 4 (and any other D3D9-only GPU) are told apart only by what their
+// drivers answer here, never by vendor or device id.
+gfx::Size ProbeMaxDecodeSize() {
+  static const gfx::Size kMaxSize = []() -> gfx::Size {
+    Microsoft::WRL::ComPtr<IDirect3DDevice9Ex> device = GetAngleD3D9DeviceEx();
+    if (!device) {
+      VLOG(1) << "DXVAVideoDecoder: no ANGLE D3D9Ex device";
+      return gfx::Size();
+    }
+    if (!::GetModuleHandle(L"msmpeg2vdec.dll")) {
+      VLOG(1) << "DXVAVideoDecoder: msmpeg2vdec.dll was not preloaded";
+      return gfx::Size();
+    }
+    Microsoft::WRL::ComPtr<IDirect3D9> d3d9;
+    D3DDEVICE_CREATION_PARAMETERS params = {};
+    if (FAILED(device->GetDirect3D(&d3d9)) ||
+        FAILED(device->GetCreationParameters(&params))) {
+      return gfx::Size();
+    }
+    HRESULT hr = d3d9->CheckDeviceFormatConversion(
+        params.AdapterOrdinal, params.DeviceType, kNV12, D3DFMT_X8R8G8B8);
+    if (FAILED(hr)) {
+      VLOG(1) << "DXVAVideoDecoder: no NV12->X8R8G8B8 conversion, hr=0x"
+              << std::hex << hr;
+      return gfx::Size();
+    }
+    Microsoft::WRL::ComPtr<IDirectXVideoDecoderService> service;
+    hr = DXVA2CreateVideoService(device.Get(), IID_PPV_ARGS(&service));
+    if (FAILED(hr)) {
+      VLOG(1) << "DXVAVideoDecoder: DXVA2CreateVideoService failed, hr=0x"
+              << std::hex << hr;
+      return gfx::Size();
+    }
+    UINT guid_count = 0;
+    GUID* guids = nullptr;
+    if (FAILED(service->GetDecoderDeviceGuids(&guid_count, &guids))) {
+      return gfx::Size();
+    }
+    GUID mode = GUID_NULL;
+    for (UINT i = 0; i < guid_count; ++i) {
+      if (guids[i] == kDxva2ModeH264E || guids[i] == kDxva2ModeH264F) {
+        mode = guids[i];
+        break;
+      }
+    }
+    ::CoTaskMemFree(guids);
+    if (mode == GUID_NULL) {
+      VLOG(1) << "DXVAVideoDecoder: driver has no DXVA2 H.264 VLD mode";
+      return gfx::Size();
+    }
+    UINT format_count = 0;
+    D3DFORMAT* formats = nullptr;
+    if (FAILED(
+            service->GetDecoderRenderTargets(mode, &format_count, &formats))) {
+      return gfx::Size();
+    }
+    bool has_nv12 = false;
+    for (UINT i = 0; i < format_count; ++i) {
+      has_nv12 |= formats[i] == kNV12;
+    }
+    ::CoTaskMemFree(formats);
+    if (!has_nv12) {
+      VLOG(1) << "DXVAVideoDecoder: H.264 VLD mode has no NV12 render target";
+      return gfx::Size();
+    }
+    for (const gfx::Size size : {gfx::Size(1920, 1088), gfx::Size(1280, 720)}) {
+      DXVA2_VideoDesc desc = {};
+      desc.SampleWidth = size.width();
+      desc.SampleHeight = size.height();
+      desc.Format = kNV12;
+      desc.SampleFormat.SampleFormat = DXVA2_SampleProgressiveFrame;
+      desc.InputSampleFreq = {30, 1};
+      desc.OutputFrameFreq = {30, 1};
+      UINT config_count = 0;
+      DXVA2_ConfigPictureDecode* configs = nullptr;
+      hr = service->GetDecoderConfigurations(mode, &desc, nullptr,
+                                             &config_count, &configs);
+      ::CoTaskMemFree(configs);
+      if (SUCCEEDED(hr) && config_count > 0) {
+        VLOG(1) << "DXVAVideoDecoder: hardware H.264 up to "
+                << size.ToString();
+        return size;
+      }
+    }
+    VLOG(1) << "DXVAVideoDecoder: no H.264 decoder configuration";
+    return gfx::Size();
+  }();
+  return kMaxSize;
+}
