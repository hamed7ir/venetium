+// Every output sample is copied out of the MFT before the next one is pulled,
+// but one may be held while waiting for a free picture buffer.
+constexpr UINT32 kMinOutputSamples = 2;
+// Bound on MF_E_TRANSFORM_STREAM_CHANGE renegotiations in one DoDecode() pass.
+constexpr int kMaxStreamChanges = 10;
+// Bound on S_OK-without-a-sample results in one DoDecode() pass.
+constexpr int kMaxNullSamples = 3;
