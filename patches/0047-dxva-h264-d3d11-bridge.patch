+// Venetium 0047: a standalone IDirect3DDevice9Ex for decoding when ANGLE has no D3D9 device (ANGLE
+// on D3D11 - e.g. an Adreno at FL 9_3, via 0045). DXVA2 is a D3D9 component, but the decode device
+// is independent of the render device; the output is bridged into ANGLE's D3D11 device. d3d9.dll is
+// loaded dynamically so media/gpu keeps no link-time dependency on Direct3DCreate9Ex.
+Microsoft::WRL::ComPtr<IDirect3DDevice9Ex> CreateOwnD3D9DeviceEx() {
+  using Create9ExFn = HRESULT(WINAPI*)(UINT, IDirect3D9Ex**);
+  HMODULE d3d9 = ::GetModuleHandleW(L"d3d9.dll");
+  if (!d3d9) {
+    d3d9 = ::LoadLibraryW(L"d3d9.dll");
+  }
+  if (!d3d9) {
+    return nullptr;
+  }
+  auto create =
+      reinterpret_cast<Create9ExFn>(::GetProcAddress(d3d9, "Direct3DCreate9Ex"));
+  if (!create) {
+    return nullptr;
+  }
+  Microsoft::WRL::ComPtr<IDirect3D9Ex> d3d9ex;
+  if (FAILED(create(D3D_SDK_VERSION, &d3d9ex)) || !d3d9ex) {
+    return nullptr;
+  }
+  D3DPRESENT_PARAMETERS pp = {};
+  pp.BackBufferWidth = 1;
+  pp.BackBufferHeight = 1;
+  pp.BackBufferFormat = D3DFMT_UNKNOWN;
+  pp.BackBufferCount = 1;
+  pp.SwapEffect = D3DSWAPEFFECT_DISCARD;
+  pp.hDeviceWindow = ::GetShellWindow();
+  pp.Windowed = TRUE;
+  pp.Flags = D3DPRESENTFLAG_VIDEO;
+  pp.PresentationInterval = D3DPRESENT_INTERVAL_DEFAULT;
+  Microsoft::WRL::ComPtr<IDirect3DDevice9Ex> device;
+  HRESULT hr = d3d9ex->CreateDeviceEx(
+      D3DADAPTER_DEFAULT, D3DDEVTYPE_HAL, pp.hDeviceWindow,
+      D3DCREATE_FPU_PRESERVE | D3DCREATE_HARDWARE_VERTEXPROCESSING |
+          D3DCREATE_MULTITHREADED,
+      &pp, nullptr, &device);
+  if (FAILED(hr) || !device) {
+    return nullptr;
+  }
+  return device;
+}
