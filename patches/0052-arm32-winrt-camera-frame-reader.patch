+template <typename T>
+void CloseIfClosable(T* object) {
+  if (!object) {
+    return;
+  }
+  ComPtr<wf::IClosable> closable;
+  if (SUCCEEDED(object->QueryInterface(IID_PPV_ARGS(&closable))) && closable) {
+    closable->Close();
+  }
+}
