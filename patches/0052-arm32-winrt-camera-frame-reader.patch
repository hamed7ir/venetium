+std::string HStr8(HSTRING h) {
+  UINT32 n = 0;
+  const wchar_t* w = ::WindowsGetStringRawBuffer(h, &n);
+  if (!w || n == 0) {
+    return std::string();
+  }
+  return base::WideToUTF8(std::wstring(w, n));
+}
