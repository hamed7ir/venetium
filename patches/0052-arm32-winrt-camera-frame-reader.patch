+// A Win32 event shared with WinRT completion/event handlers. Each handler holds a reference, so a callback that fires
+// late (after a timeout, or during teardown) still signals a live handle rather than a closed - possibly recycled -
+// one. Also carries the code of the last MediaCapture.Failed event.
+class SharedEvent : public base::RefCountedThreadSafe<SharedEvent> {
+ public:
+  explicit SharedEvent(bool manual_reset)
+      : handle_(::CreateEventW(nullptr, manual_reset ? TRUE : FALSE, FALSE, nullptr)) {}
+  SharedEvent(const SharedEvent&) = delete;
+  SharedEvent& operator=(const SharedEvent&) = delete;
+
+  HANDLE handle() const { return handle_; }
+  void Signal() {
+    if (handle_) {
+      ::SetEvent(handle_);
+    }
+  }
+
+  std::atomic<uint32_t> failure_code{0};
+
+ private:
+  friend class base::RefCountedThreadSafe<SharedEvent>;
+  ~SharedEvent() {
+    if (handle_) {
+      ::CloseHandle(handle_);
+    }
+  }
+
+  const HANDLE handle_;
+};
