+//
+// Venetium: a WinRT MediaCapture-based VideoCaptureDevice for Windows ARM32 (Surface RT / Surface 2 Tegra, Lumia).
+// On this hardware the desktop Media Foundation capture path (VideoCaptureDeviceMFWin) enumerates and opens the
+// NVIDIA Unified AvStream camera but cannot START STREAMING it (ReadSample / the hardware MFT fails with
+// MF_E_HW_MFT_FAILED_START_STREAMING, 0xC00D3704). WinRT Windows.Media.Capture.MediaCapture can, provided it is
+// initialized without MemoryPreference=Cpu (which breaks this camera). This device streams the camera's VideoPreview
+// source through a MediaFrameReader on a dedicated MTA thread - 30 fps on the Surface Tegra (device probe) - copying
+// each frame (a Direct3D surface here) to the CPU and handing it to the pipeline as NV12 / YUY2. If the reader can't
+// stream on a device it falls back to polling photo capture (CapturePhotoToStreamAsync, delivered as MJPEG), which
+// works everywhere but only at the photo cadence (~2 fps on the Tegra).
+
+#ifndef MEDIA_CAPTURE_VIDEO_WIN_VIDEO_CAPTURE_DEVICE_WINRT_H_
+#define MEDIA_CAPTURE_VIDEO_WIN_VIDEO_CAPTURE_DEVICE_WINRT_H_
+
+#include <atomic>
+#include <memory>
+
+#include "base/synchronization/waitable_event.h"
+#include "base/threading/thread.h"
+#include "media/capture/capture_export.h"
+#include "media/capture/video/video_capture_device.h"
+#include "media/capture/video/video_capture_device_descriptor.h"
+
+namespace media {
+
+class CAPTURE_EXPORT VideoCaptureDeviceWinRT : public VideoCaptureDevice {
+ public:
+  explicit VideoCaptureDeviceWinRT(const VideoCaptureDeviceDescriptor& descriptor);
+
+  VideoCaptureDeviceWinRT(const VideoCaptureDeviceWinRT&) = delete;
+  VideoCaptureDeviceWinRT& operator=(const VideoCaptureDeviceWinRT&) = delete;
+
+  ~VideoCaptureDeviceWinRT() override;
+
+  // VideoCaptureDevice:
+  void AllocateAndStart(const VideoCaptureParams& params,
+                        std::unique_ptr<Client> client) override;
+  void StopAndDeAllocate() override;
+
+ private:
+  // Runs on |capture_thread_|: initializes WinRT MediaCapture and streams frames (frame reader, else photo polling)
+  // until |stop_| is set.
+  void CaptureLoopOnThread();
+
+  const VideoCaptureDeviceDescriptor descriptor_;
+  VideoCaptureParams params_;
+
+  // The capture loop runs here (its own MTA thread; WinRT async is driven by blocking waits).
+  base::Thread capture_thread_;
+
+  // Owned by the device; only touched on |capture_thread_| once the loop starts.
+  std::unique_ptr<Client> client_;
+
+  std::atomic<bool> stop_{false};
+
+  // Signalled together with |stop_|: wakes the capture loop and interrupts any blocking WinRT wait at once, so
+  // StopAndDeAllocate() never waits out a slow or hung camera call.
+  base::WaitableEvent stop_event_{base::WaitableEvent::ResetPolicy::MANUAL,
+                                  base::WaitableEvent::InitialState::NOT_SIGNALED};
+};
+
+}  // namespace media
