+// The final status of a completed WinRT async operation as an HRESULT (S_OK only if it Completed).
+HRESULT AsyncResult(IUnknown* op) {
+  ComPtr<wf::IAsyncInfo> info;
+  if (FAILED(op->QueryInterface(IID_PPV_ARGS(&info))) || !info) {
+    return E_NOINTERFACE;
+  }
+  wf::AsyncStatus status = wf::AsyncStatus::Started;
+  info->get_Status(&status);
+  if (status == wf::AsyncStatus::Completed) {
+    return S_OK;
+  }
+  HRESULT error = S_OK;
+  info->get_ErrorCode(&error);
+  if (status == wf::AsyncStatus::Canceled) {
+    return FAILED(error) ? error : E_ABORT;
+  }
+  return FAILED(error) ? error : E_FAIL;
+}
+
+// Waits for |done| (the completion handler) or |stop| (may be null). On stop or timeout the operation is cancelled
+// and given a moment to settle, so a retry doesn't race a half-finished call on the same camera.
+HRESULT WaitForCompletion(IUnknown* op, SharedEvent* done, HANDLE stop, DWORD timeout_ms) {
+  HANDLE handles[2] = {done->handle(), stop};
+  const DWORD count = stop ? 2 : 1;
+  const DWORD result = ::WaitForMultipleObjects(count, handles, FALSE, timeout_ms);
+  if (result == WAIT_OBJECT_0) {
+    return AsyncResult(op);
+  }
+  ComPtr<wf::IAsyncInfo> info;
+  if (SUCCEEDED(op->QueryInterface(IID_PPV_ARGS(&info))) && info) {
+    info->Cancel();
+  }
+  ::WaitForSingleObject(done->handle(), 1000);
+  return result == WAIT_OBJECT_0 + 1 ? E_ABORT : HRESULT_FROM_WIN32(ERROR_TIMEOUT);
+}
+
+// Block on a WinRT IAsyncAction; returns its result (S_OK on success, E_ABORT if |stop| was signalled).
+HRESULT AwaitAction(wf::IAsyncAction* op, HANDLE stop, DWORD timeout_ms = 10000) {
+  if (!op) {
+    return E_POINTER;
+  }
+  auto done = base::MakeRefCounted<SharedEvent>(/*manual_reset=*/true);
+  if (!done->handle()) {
+    return HRESULT_FROM_WIN32(::GetLastError());
+  }
+  auto cb = Callback<wf::IAsyncActionCompletedHandler>(
+      [done](wf::IAsyncAction*, wf::AsyncStatus) -> HRESULT {
+        done->Signal();
+        return S_OK;
+      });
+  HRESULT hr = op->put_Completed(cb.Get());
+  if (FAILED(hr)) {
+    return hr;
+  }
+  return WaitForCompletion(op, done.get(), stop, timeout_ms);
+}
+
+// Block on a WinRT IAsyncOperation<T>; returns its result (S_OK on success, E_ABORT if |stop| was signalled).
+template <typename T>
+HRESULT AwaitOp(wf::IAsyncOperation<T>* op, HANDLE stop, DWORD timeout_ms = 10000) {
+  if (!op) {
+    return E_POINTER;
+  }
+  auto done = base::MakeRefCounted<SharedEvent>(/*manual_reset=*/true);
+  if (!done->handle()) {
+    return HRESULT_FROM_WIN32(::GetLastError());
+  }
+  auto cb = Callback<wf::IAsyncOperationCompletedHandler<T>>(
+      [done](wf::IAsyncOperation<T>*, wf::AsyncStatus) -> HRESULT {
+        done->Signal();
+        return S_OK;
+      });
+  HRESULT hr = op->put_Completed(cb.Get());
+  if (FAILED(hr)) {
+    return hr;
+  }
+  return WaitForCompletion(op, done.get(), stop, timeout_ms);
+}
