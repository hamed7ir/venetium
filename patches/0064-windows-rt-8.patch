@@ -49,6 +134,17 @@ FARPROC WINAPI DelayLoadFailureHook(unsigned reason, DelayLoadInfo* dll_info) {
     }
   }
 
+  // Venetium RT 8.0: a missing DLL with a stand-in for this function gets
+  // kernel32 as its module, so the helper's GetProcAddress fails and the
+  // dliFailGetProc call below hands out the stand-in.
+  if (FARPROC stand_in = StandInFor(dll_info)) {
+    if (reason == dliFailLoadLib) {
+      return reinterpret_cast<FARPROC>(::GetModuleHandleW(L"kernel32.dll"));
+    }
+    if (reason == dliFailGetProc) {
+      return stand_in;
+    }
+  }
   return HandleDelayLoadFailureCommon(reason, dll_info);
 }
 
