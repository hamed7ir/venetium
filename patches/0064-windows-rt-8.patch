+  if (ref) {
+    *ref = nullptr;
+  }
+  return E_NOTIMPL;
+}
+BOOL WINAPI ProcessPrngStandIn(PBYTE data, SIZE_T size) {
+  using RtlGenRandomFunction = BOOLEAN(WINAPI*)(PVOID, ULONG);
+  const auto rtl_gen_random = reinterpret_cast<RtlGenRandomFunction>(
+      ::GetProcAddress(::LoadLibraryW(L"advapi32.dll"), "SystemFunction036"));
+  return rtl_gen_random &&
+         rtl_gen_random(data, base::checked_cast<ULONG>(size));
