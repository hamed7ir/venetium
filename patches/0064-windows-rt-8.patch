+FARPROC StandInFor(const DelayLoadInfo* dll_info) {
+  if (!dll_info->dlp.fImportByName) {
+    // d3d12.dll is imported by ordinal: 101 = D3D12CreateDevice.
+    return base::EqualsCaseInsensitiveASCII(dll_info->szDll, "d3d12.dll") &&
+                   dll_info->dlp.dwOrdinal == 101
+               ? reinterpret_cast<FARPROC>(&D3D12CreateDeviceStandIn)
+               : nullptr;
+  }
+  const std::string_view name(dll_info->dlp.szProcName);
+  if (name == "SetProcessDpiAwareness") {
+    return reinterpret_cast<FARPROC>(&SetProcessDpiAwarenessStandIn);
+  }
+  if (name == "GetDpiForMonitor") {
+    return reinterpret_cast<FARPROC>(&GetDpiForMonitorStandIn);
+  }
+  if (name == "GetScaleFactorForMonitor") {
+    return reinterpret_cast<FARPROC>(&GetScaleFactorForMonitorStandIn);
+  }
+  if (name == "QueryUnbiasedInterruptTimePrecise") {
+    return reinterpret_cast<FARPROC>(&QueryUnbiasedInterruptTimePreciseStandIn);
+  }
+  if (name == "CompareObjectHandles") {
+    return reinterpret_cast<FARPROC>(&CompareObjectHandlesStandIn);
+  }
+  if (name == "NetGetAadJoinInformation") {
+    return reinterpret_cast<FARPROC>(&NetGetAadJoinInformationStandIn);
+  }
+  if (name == "NetFreeAadJoinInformation") {
+    return reinterpret_cast<FARPROC>(&NetFreeAadJoinInformationStandIn);
+  }
+  if (name == "RoGetAgileReference") {
+    return reinterpret_cast<FARPROC>(&RoGetAgileReferenceStandIn);
+  }
+  if (name == "ProcessPrng") {
+    return reinterpret_cast<FARPROC>(&ProcessPrngStandIn);
+  }
+  return nullptr;
+}
