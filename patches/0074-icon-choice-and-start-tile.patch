 std::unique_ptr<gfx::ImageFamily> GetAppIconImageFamily() {
+  if (!VenetiumIconOverride().empty()) {
+    auto family = std::make_unique<gfx::ImageFamily>();
+    for (int size : {16, 20, 24, 32, 40, 48, 64, 96, 128, 256}) {
+      HICON icon = LoadVenetiumIconOverride(size, size);
+      if (!icon) {
+        continue;
+      }
+      SkBitmap bitmap = IconUtil::CreateSkBitmapFromHICON(icon);
+      ::DestroyIcon(icon);
+      if (!bitmap.isNull()) {
+        family->Add(gfx::Image::CreateFrom1xBitmap(bitmap));
+      }
+    }
+    if (!family->empty()) {
+      return family;
+    }
+  }
