+// Venetium 0074: an icon file beside venetium.exe, venetium-icon.ico, replaces the built-in
+// application icon for the browser windows, the taskbar button, the tray icon and the profile
+// shortcut icons. The installer's icon choice (Venetium's icon, its WinRT-style icon or the
+// user's own .ico) and set-icon.cmd in portable copies write it; without the file (or with one
+// that is not a valid icon) nothing changes. Looked up once per browser run.
+const base::FilePath& VenetiumIconOverride() {
+  static const base::NoDestructor<base::FilePath> path([] {
+    base::FilePath exe_dir;
+    if (!base::PathService::Get(base::DIR_EXE, &exe_dir)) {
+      return base::FilePath();
+    }
+    base::FilePath icon =
+        exe_dir.Append(FILE_PATH_LITERAL("venetium-icon.ico"));
+    HICON probe = static_cast<HICON>(::LoadImageW(
+        nullptr, icon.value().c_str(), IMAGE_ICON, 32, 32, LR_LOADFROMFILE));
+    if (!probe) {
+      return base::FilePath();
+    }
+    ::DestroyIcon(probe);
+    return icon;
+  }());
+  return *path;
+}
+
+// A new icon handle of the override at this size, owned by the caller (callers destroy what
+// GetAppIcon and GetSmallAppIcon return), or null when there is no override.
+HICON LoadVenetiumIconOverride(int width, int height) {
+  const base::FilePath& icon = VenetiumIconOverride();
+  if (icon.empty()) {
+    return nullptr;
+  }
+  return static_cast<HICON>(::LoadImageW(nullptr, icon.value().c_str(),
+                                         IMAGE_ICON, width, height,
+                                         LR_LOADFROMFILE));
+}
+
 }  // namespace
 
