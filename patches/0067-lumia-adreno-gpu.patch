diff --git a/third_party/angle/src/libANGLE/renderer/d3d/d3d11/RenderStateCache.cpp b/third_party/angle/src/libANGLE/renderer/d3d/d3d11/RenderStateCache.cpp
--- a/third_party/angle/src/libANGLE/renderer/d3d/d3d11/RenderStateCache.cpp
+++ b/third_party/angle/src/libANGLE/renderer/d3d/d3d11/RenderStateCache.cpp
@@ -184,6 +184,35 @@
         rtDesc.RenderTargetWriteMask = blendStateExt.getColorMaskIndexed(i);
     }
 
+#if defined(_M_ARM)
+    // Venetium 0067: feature level 9_x rejects a blend state with AlphaToCoverageEnable or
+    // IndependentBlendEnable set (checked against the D3D11 runtime on WARP at 9_3), so a draw
+    // with alpha-to-coverage on, or with more than one render target bound, failed on an Adreno at
+    // 9_3. Per-buffer blend state needs 10_1 and is not offered there, so the bound render targets
+    // normally share one description and RenderTarget[0] alone says it; alpha-to-coverage has no
+    // 9_x form and is dropped.
+    if (renderer->getRenderer11DeviceCaps().featureLevel <= D3D_FEATURE_LEVEL_9_3)
+    {
+        blendDesc.AlphaToCoverageEnable = FALSE;
+        const D3D11_RENDER_TARGET_BLEND_DESC &rt0 = blendDesc.RenderTarget[0];
+        bool sameForAll                           = true;
+        for (size_t i = 1; i < key.rtvMax; i++)
+        {
+            const D3D11_RENDER_TARGET_BLEND_DESC &rt = blendDesc.RenderTarget[i];
+            sameForAll = sameForAll && rt.BlendEnable == rt0.BlendEnable &&
+                         rt.SrcBlend == rt0.SrcBlend && rt.DestBlend == rt0.DestBlend &&
+                         rt.BlendOp == rt0.BlendOp && rt.SrcBlendAlpha == rt0.SrcBlendAlpha &&
+                         rt.DestBlendAlpha == rt0.DestBlendAlpha &&
+                         rt.BlendOpAlpha == rt0.BlendOpAlpha &&
+                         rt.RenderTargetWriteMask == rt0.RenderTargetWriteMask;
+        }
+        if (sameForAll)
+        {
+            blendDesc.IndependentBlendEnable = FALSE;
+        }
+    }
+#endif
+
     d3d11::BlendState d3dBlendState;
     ANGLE_TRY(renderer->allocateResource(GetImplAs<Context11>(context), blendDesc, &d3dBlendState));
     const auto &iter = mBlendStateCache.Put(key, std::move(d3dBlendState));
