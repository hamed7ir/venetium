+#if BUILDFLAG(IS_WIN) && defined(ARCH_CPU_ARMEL)
+// Venetium 0045: one-shot probe of the real hardware GPU's Direct3D feature level, so the ANGLE
+// backend is CHOSEN on Windows ARM32 rather than tried-D3D11-then-fallen-back-to-D3D9 (that churned
+// on the Tegra - DEVICE-7's ~18 s stall - because it created a low-FL D3D11 device it couldn't use).
+// Returns true iff a HARDWARE D3D11 device reaches feature level 9_3: the Adreno (Lumia) does and
+// takes the clean D3D11 path; the Tegra tops out at 9_1, returns false, and stays on D3D9. d3d11.dll
+// is loaded dynamically, so ui/gl keeps no link-time dependency on it.
+bool VenetiumArm32PrefersD3D11() {
+  static const bool prefers = [] {
+    HMODULE d3d11 = ::LoadLibraryW(L"d3d11.dll");
+    if (!d3d11) {
+      return false;
+    }
+    auto create = reinterpret_cast<PFN_D3D11_CREATE_DEVICE>(
+        ::GetProcAddress(d3d11, "D3D11CreateDevice"));
+    if (!create) {
+      ::FreeLibrary(d3d11);
+      return false;
+    }
+    const D3D_FEATURE_LEVEL levels[] = {
+        D3D_FEATURE_LEVEL_11_1, D3D_FEATURE_LEVEL_11_0, D3D_FEATURE_LEVEL_10_1,
+        D3D_FEATURE_LEVEL_10_0, D3D_FEATURE_LEVEL_9_3};
+    D3D_FEATURE_LEVEL got = D3D_FEATURE_LEVEL_9_1;
+    ID3D11Device* device = nullptr;
+    HRESULT hr = create(nullptr, D3D_DRIVER_TYPE_HARDWARE, nullptr, 0, levels,
+                        sizeof(levels) / sizeof(levels[0]), D3D11_SDK_VERSION,
+                        &device, &got, nullptr);
+    if (device) {
+      device->Release();
+    }
+    ::FreeLibrary(d3d11);
+    return SUCCEEDED(hr) && got >= D3D_FEATURE_LEVEL_9_3;
+  }();
+  return prefers;
+}
+#endif  // BUILDFLAG(IS_WIN) && defined(ARCH_CPU_ARMEL)
+
