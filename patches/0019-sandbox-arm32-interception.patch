diff --git a/sandbox/win/src/resolver_arm.cc b/sandbox/win/src/resolver_arm.cc
new file mode 100644
index 0000000..c0ce01b
--- /dev/null
+++ b/sandbox/win/src/resolver_arm.cc
@@ -0,0 +1,81 @@
+// Copyright 2006-2010 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "sandbox/win/src/resolver.h"
+
+#include <windows.h>
+
+#include <ntstatus.h>
+#include <stddef.h>
+
+// For placement new. This file must not depend on the CRT at runtime, but
+// placement operator new is inline.
+#include <new>
+
+namespace {
+
+// ldr.w pc, [pc, #0]: the two Thumb-2 halfwords F8DF F000, stored in memory
+// (little endian) as DF F8 00 F0.
+const ULONG kLdrPcPc0 = 0xF000F8DF;
+
+#pragma pack(push, 4)
+struct InternalThunk {
+  // This struct contains the following Thumb-2 code:
+  // 00 f8df f000   ldr.w   pc, [pc, #0]
+  // 04 <interceptor>  .word interceptor_function  (bit 0 set)
+  //
+  // pc reads as the address of the instruction plus 4 and `ldr` (literal)
+  // aligns it down to a multiple of 4, so the thunk has to start at a 4-byte
+  // aligned address for the literal to be the word that follows the
+  // instruction. Loading pc from memory is an interworking branch: bit 0 of the
+  // loaded value selects the instruction set, so the literal must have bit 0
+  // set (Windows on ARM32 only runs Thumb-2 code).
+  //
+  // The code only modifies pc. Registers r0-r3, r12, sp and lr are untouched,
+  // so the interceptor receives the arguments and the return address of the
+  // call that was patched.
+  //
+  // NOTE: the thunk is written either into a local buffer that is then copied
+  // to the patched function (ServiceResolverThunk) or in place, in memory that
+  // will execute (EatResolverThunk). Nothing here flushes the instruction
+  // cache; if the device shows stale code, the flush belongs after the writes
+  // of those two callers (see service_resolver_arm.cc and eat_resolver.cc).
+
+  InternalThunk() {
+    ldr_pc_pc0 = kLdrPcPc0;
+    interceptor_function = 0;
+  }
+  ULONG ldr_pc_pc0;  // = DF F8 00 F0
+  ULONG_PTR interceptor_function;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(InternalThunk) == 8,
+              "the thunk has to fit in an 8 byte ntdll system call stub");
+
+}  // namespace.
+
+namespace sandbox {
+
+size_t ResolverThunk::GetInternalThunkSize() const {
+  return sizeof(InternalThunk);
+}
+
+bool ResolverThunk::SetInternalThunk(void* storage,
+                                     size_t storage_bytes,
+                                     const void* original_function,
+                                     const void* interceptor) {
+  if (storage_bytes < sizeof(InternalThunk))
+    return false;
+
+  InternalThunk* thunk = new (storage) InternalThunk;
+  // Every function on Windows ARM32 is Thumb-2 code, so every code address has
+  // bit 0 set. Make sure of it: a jump to an even address would switch the
+  // processor to ARM state.
+  thunk->interceptor_function = reinterpret_cast<ULONG_PTR>(interceptor) | 1;
+
+  return true;
+}
+
+}  // namespace sandbox
