diff --git a/sandbox/win/src/service_resolver_arm.cc b/sandbox/win/src/service_resolver_arm.cc
new file mode 100644
index 0000000..be48cb6
--- /dev/null
+++ b/sandbox/win/src/service_resolver_arm.cc
@@ -0,0 +1,221 @@
+// Copyright 2012 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "sandbox/win/src/service_resolver.h"
+
+#include <windows.h>
+#include <winternl.h>
+
+#include <ntstatus.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include <memory>
+
+#include "base/compiler_specific.h"
+#include "base/containers/heap_array.h"
+
+namespace {
+#pragma pack(push, 4)
+
+// mov.w r12, #imm: the Thumb-2 halfwords F04F|i<<10 and 0|imm3<<12|C<<8|imm8,
+// as one little endian ULONG. The mask leaves out the bits that hold the
+// immediate (the service id) and requires everything else, including Rd = r12
+// and S = 0.
+const ULONG kMovWR12 = 0x0C00F04F;
+const ULONG kMovWR12Mask = 0x8F00FBFF;
+
+// movw r12, #imm16: the Thumb-2 halfwords F240|i<<10|imm4 and
+// 0|imm3<<12|C<<8|imm8. Used when the id is not a "modified immediate".
+const ULONG kMovwR12 = 0x0C00F240;
+const ULONG kMovwR12Mask = 0x8F00FBF0;
+
+const USHORT kSvc1 = 0xDF01;
+const USHORT kBxLr = 0x4770;
+
+// Service code for ARM32 (Thumb-2) Windows.
+struct ServiceEntry {
+  // This struct contains one of the following two versions of code:
+  // 00 f04f 0c2a   mov.w   r12, #0x2a
+  // 04 df01        svc     #1
+  // 06 4770        bx      lr
+  //
+  // 00 f240 1ca5   movw    r12, #0x1a5
+  // 04 df01        svc     #1
+  // 06 4770        bx      lr
+  //
+  // ntdll lays these stubs out 16 bytes apart; the 8 bytes that follow each one
+  // are zero padding. That padding is not looked at and not modified: the patch
+  // (the ResolverThunk's `ldr.w pc, [pc, #0]` and its literal) is also 8 bytes.
+
+  ULONG mov_r12;  // = mov.w or movw r12, #service id
+  USHORT svc;     // = DF 01
+  USHORT bx_lr;   // = 70 47
+};
+
+// We don't have an internal thunk for ARM32 either: the original code is
+// copied as it is, and the patch is built in a ServiceEntry.
+struct ServiceFullThunk {
+  ServiceEntry original;
+};
+
+#pragma pack(pop)
+
+static_assert(sizeof(ServiceEntry) == 8,
+              "an ARM32 system call stub is 8 bytes long");
+
+bool IsService(const void* source) {
+  const ServiceEntry* service = reinterpret_cast<const ServiceEntry*>(source);
+
+  return ((kMovWR12 == (service->mov_r12 & kMovWR12Mask) ||
+           kMovwR12 == (service->mov_r12 & kMovwR12Mask)) &&
+          kSvc1 == service->svc && kBxLr == service->bx_lr);
+}
+
+bool IsAnyService(const void* source) {
+  return IsService(source);
+}
+
+// The address of a Thumb function has bit 0 set: that bit selects the
+// instruction set, it is not part of the address of the code. Everything that
+// reads or writes the code (and not just branches to it) needs it cleared.
+void* ClearThumbBit(void* address) {
+  return reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(address) &
+                                 ~static_cast<uintptr_t>(1));
+}
+
+}  // namespace
+
+namespace sandbox {
+
+NTSTATUS ServiceResolverThunk::Setup(const void* target_module,
+                                     const char* target_name,
+                                     const void* interceptor_entry_point,
+                                     void* thunk_storage,
+                                     size_t storage_bytes,
+                                     size_t* storage_used) {
+  NTSTATUS ret = Init(target_module, target_name, interceptor_entry_point,
+                      thunk_storage, storage_bytes);
+  if (!NT_SUCCESS(ret))
+    return ret;
+
+  // The export table gives the address of the Thumb function, with bit 0 set.
+  target_ = ClearThumbBit(target_);
+
+  size_t thunk_bytes = GetThunkSize();
+  auto thunk_buffer = base::HeapArray<char>::Uninit(thunk_bytes);
+  ServiceFullThunk* thunk =
+      reinterpret_cast<ServiceFullThunk*>(thunk_buffer.data());
+
+  if (!IsFunctionAService(&thunk->original))
+    return STATUS_OBJECT_NAME_COLLISION;
+
+  ret = PerformPatch(thunk, thunk_storage);
+
+  if (storage_used)
+    *storage_used = thunk_bytes;
+
+  return ret;
+}
+
+size_t ServiceResolverThunk::GetThunkSize() const {
+  return sizeof(ServiceFullThunk);
+}
+
+NTSTATUS ServiceResolverThunk::CopyThunk(const void* target_module,
+                                         const char* target_name,
+                                         BYTE* thunk_storage,
+                                         size_t storage_bytes,
+                                         size_t* storage_used) {
+  NTSTATUS ret = ResolveTarget(target_module, target_name, &target_);
+  if (!NT_SUCCESS(ret))
+    return ret;
+
+  target_ = ClearThumbBit(target_);
+
+  size_t thunk_bytes = GetThunkSize();
+  if (storage_bytes < thunk_bytes)
+    return STATUS_UNSUCCESSFUL;
+
+  ServiceFullThunk* thunk = reinterpret_cast<ServiceFullThunk*>(thunk_storage);
+
+  if (!IsFunctionAService(&thunk->original))
+    return STATUS_OBJECT_NAME_COLLISION;
+
+  if (storage_used)
+    *storage_used = thunk_bytes;
+
+  return ret;
+}
+
+bool ServiceResolverThunk::IsFunctionAService(void* local_thunk) const {
+  // The patch is `ldr.w pc, [pc, #0]` followed by its literal, which only works
+  // at an address that is a multiple of 4. ntdll's stubs all are (they are 16
+  // bytes apart); refuse anything else instead of writing a jump that goes to
+  // the wrong place.
+  if (reinterpret_cast<uintptr_t>(target_) & 3)
+    return false;
+
+  ServiceFullThunk function_code;
+  SIZE_T read;
+  if (!::ReadProcessMemory(process_, target_, &function_code,
+                           sizeof(function_code), &read))
+    return false;
+
+  if (sizeof(function_code) != read)
+    return false;
+
+  if (!IsAnyService(&function_code))
+    return false;
+
+  // Save the verified code.
+  UNSAFE_TODO(memcpy(local_thunk, &function_code, sizeof(function_code)));
+
+  return true;
+}
+
+NTSTATUS ServiceResolverThunk::PerformPatch(void* local_thunk,
+                                            void* remote_thunk) {
+  // Patch the original code.
+  ServiceEntry local_service;
+  if (!SetInternalThunk(&local_service, sizeof(local_service), nullptr,
+                        interceptor_))
+    return STATUS_UNSUCCESSFUL;
+
+  // Copy the local thunk buffer to the child. The copy is the original system
+  // call, which the interceptor calls through g_originals; it is called as a
+  // Thumb function (see InterceptionManager::PatchClientFunctions).
+  SIZE_T actual;
+  if (!::WriteProcessMemory(process_, remote_thunk, local_thunk,
+                            sizeof(ServiceFullThunk), &actual))
+    return STATUS_UNSUCCESSFUL;
+
+  if (sizeof(ServiceFullThunk) != actual)
+    return STATUS_UNSUCCESSFUL;
+
+  // And now change the function to intercept, on the child.
+  if (ntdll_base_) {
+    // Running a unit test, or a local patch (chrome_elf).
+    if (!::WriteProcessMemory(process_, target_, &local_service,
+                              sizeof(local_service), &actual))
+      return STATUS_UNSUCCESSFUL;
+  } else {
+    if (!WriteProtectedChildMemory(process_, target_, &local_service,
+                                   sizeof(local_service)))
+      return STATUS_UNSUCCESSFUL;
+  }
+
+  // NOTE: no ::FlushInstructionCache(process_, ...) after the two writes above
+  // (neither for remote_thunk nor for target_). WriteProcessMemory is expected
+  // to do it for what it writes; if a device run shows stale code, this is
+  // where the explicit calls go.
+
+  return STATUS_SUCCESS;
+}
+
+bool ServiceResolverThunk::VerifyJumpTargetForTesting(void*) const {
+  return true;
+}
+
+}  // namespace sandbox
