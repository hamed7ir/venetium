+// Venetium 0027: IsWindowArranged() is resolved at run time. The Windows SDK
+// 19041 user32.lib that the Windows ARM32 build links against has no stub for
+// it, and user32.dll before Windows 10 does not export it (user32 is
+// delay-loaded, so the first call there would fail). Where it is missing, no
+// window counts as arranged.
+bool IsWindowArrangedIfAvailable(HWND hwnd) {
+  static const auto is_window_arranged =
+      reinterpret_cast<decltype(&::IsWindowArranged)>(
+          base::win::GetUser32FunctionPointer("IsWindowArranged"));
+  return is_window_arranged && is_window_arranged(hwnd);
+}
